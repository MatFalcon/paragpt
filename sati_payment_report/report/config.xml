<odoo>
    <data>
        <record id="report_action" model="ir.actions.report">
          <field name="name">Payment Report</field>
          <field name="model">sati_payment_report.wizard</field>
          <field name="report_type">qweb-pdf</field>
          <field name="report_name">sati_payment_report.report_payment</field>
          <field name="print_report_name">(object, 'Payment Report')</field>
        </record>

     <record id="paperformat_recibo_cobranza" model="report.paperformat">
            <field name="name">A4-recibo_cobranza</field>
            <field name="default" eval="True"/>
            <field name="format">custom</field>
            <field name="page_height">300</field>
            <field name="page_width">210</field>
            <field name="orientation">Landscape</field>
            <field name="margin_top">30</field>
            <field name="margin_bottom">10</field>
            <field name="margin_left">10</field>
            <field name="margin_right">5</field>
            <field name="header_line" eval="False"/>
            <field name="header_spacing">20</field>
            <field name="dpi">90</field>
        </record>
    </data>
</odoo>