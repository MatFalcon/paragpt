<odoo>
    <data>
        <record model="ir.ui.view" id="pagos_form_views_pagos_id">
            <field name="name">orden_pago_payment.form</field>
            <field name="model">account.payment</field>
            <field name="arch" type="xml">
                <form>
                    <!-- Campos invisibles -->
                    <field name="id" invisible="1"/>
                    <field name="is_move_sent" invisible="1"/>
                    <field name="is_reconciled" invisible="1"/>
                    <field name="is_matched" invisible="1"/>
                    <field name="payment_method_code" invisible="0"/>
                    <field name="show_partner_bank_account" invisible="1"/>
                    <field name="require_partner_bank_account" invisible="1"/>
                    <field name="available_payment_method_line_ids" invisible="1"/>
                    <field name="suitable_journal_ids" invisible="1"/>
                    <field name="country_code" invisible="1"/>
                    <field name="partner_type" invisible="1"/>
                    <field name="posted_before" invisible="1"/>
                    <field name="reconciled_invoices_type" invisible="1"/>
                    <field name="company_id" invisible="1"/>
                    <field name="paired_internal_transfer_payment_id" invisible="1"/>
                    <group>
                        <!-- Campo nombre, invisible si está vacío y solo lectura -->
                        <field name="name" invisible="name == False" readonly="1"/>
                        <!-- Campo de selección de cliente, solo lectura y guardado forzado -->
                        <field name="partner_id" readonly="1" force_save="1"/>
                        <!-- Campo de diario, con dominio específico -->
                        <field name="journal_id" invisible="0" domain="[('orden_pago_diario','=',True)]"/>
                        <!-- Campo extranjero, invisible -->
                        <field name="extranjero" invisible="1"/>
                        <!-- Campo balance, visible según condición -->
                        <field name="balance_foreign_account" invisible="extranjero == False"/>
                        <field name="balance" invisible="extranjero == True"/>
                        <!-- Campo reconciled_invoice_ids_op, invisible -->
                        <field name="reconciled_invoice_ids_op" invisible="1"/>
                        <!-- Campo asignar_factura -->
                        <field name="asignar_factura"/>
                        <!-- Campo reconciled_invoice_ids, editable según condición -->
                        <field name="reconciled_invoice_ids" domain="[('id','in',reconciled_invoice_ids_op)]" invisible="asignar_factura == False"/>
                        <!-- Campo fecha, invisible si cheque_propio es True -->
                        <field name="date" invisible="cheque_propio == True"/>
                        <!-- Campo checkbook_id, visible según condición y con dominio específico -->
                        <field name="checkbook_id" invisible="cheque_propio != True" domain="[('journal_id','=',journal_id),('state','=','active')]"/>
                        <!-- Campos adicionales invisibles -->
                        <field name="state" invisible="1"/>
                        <field name="payment_type" invisible="1"/>
                        <field name="partner_type" invisible="1"/>
                        <field name="cheque_propio" invisible="1"/>
                        <field name="orden_pago_id" invisible="1"/>
                        <field name="currency_id" domain="[('ambito','in',('compra',False))]"/>
                    </group>
                    <!-- Grupo de datos del cheque, visible y requerido según condición -->
                    <group invisible="checkbook_id == False" required="checkbook_id != False" string="Datos del cheque" style="font-weight:bold;">
                        <field name="numero_cheque_pago"/>
                        <field name="fecha_cheque_pago" string="Fecha Emisión" force_save="1"/>
                        <field name="fecha_cheque_diferido" string="Fecha de Pago" force_save="1"/>
                    </group>
                    <group>
                        <!-- Campo observaciones, invisible -->
                        <field name="observaciones" invisible="1"/>
                        <!-- Campos adicionales -->
                        <field name="ref"/>
                        <field name="moneda_pago" string="Moneda Alternativa de Pago"/>
                        <field name="monto_moneda_pago" string="Monto Alternativo de Pago"/>
                        <field name="cotizacion"/>
                        <field name="amount"/>
                    </group>
                </form>
            </field>
        </record>

        <record id="wizard_orden_pago" model="ir.ui.view">
            <field name="name">orden.pago.wizard</field>
            <field name="model">orden.pago.wizard</field>
            <field name="arch" type="xml">
                <form string="Motivo de Anulacion">
                    <group>
                        <field name="motivo_anulacion"/>
                    </group>
                    <footer>
                        <button class="oe_highlight" name="set_motivo_anulacion" string="Confirmar" type="object"/>
                        <button string="Cancelar" special="cancel"/>
                    </footer>
                </form>
            </field>
        </record>

        <record id="open_wizard_action_orden_pago_id" model="ir.actions.act_window">
            <field name="name">Motivo Anulacion</field>
            <field name="type">ir.actions.act_window</field>
            <field name="res_model">orden.pago.wizard</field>

            <field name="view_mode">form</field>
            <field name="view_id" ref="wizard_orden_pago"/>
            <field name="target">new</field>
            <field name="context">{'default_orden_pago_id':active_id}</field>
        </record>

<!--        filtros para orden de pago -->

        <record id="view_account_orden_de_pago_search" model="ir.ui.view">
                <field name="name">account.orden.pago.search</field>
                <field name="model">account.orden.pago</field>
                <field name="arch" type="xml">
                    <search string="Orden de Pago">
                        <field name="name" filter_domain="[('name','ilike',self)]" string="Nro. de Orden de Pago"/>
                        <field name="name" filter_domain="[('orden_pagos_facturas_ids.invoice_id.name', 'ilike', self)]" string="Nro. de Factura"/>
                        <separator/>
                        <field name="partner_id" />
                        <field name="company_id" groups="base.group_multi_company" string="Compañia"/>
                        <field name="currency_id"/>
                        <filter string="Borrador" domain="[('state','=','borrador')]" name='state_borrador'/>
                        <filter string="Confirmado" domain="[('state','=','confirmado')]" name='state_confirmado'/>
                        <filter string="Anulado" domain="[('state','=','anulado')]" name='state_anulado'/>
                        <separator/>
                        <filter string="Proveedor" domain="[]" context="{'group_by': 'partner_id'}" name="partner_id"/>
                        <filter string="Estado" domain="[]" context="{'group_by': 'state'}" name="state"/>
                        <filter string="Moneda" domain="[]" context="{'group_by': 'currency_id'}" name="currency_id" groups="base.group_multi_currency"/>
                        <filter string="Compañia" domain="[]" context="{'group_by': 'company_id'}" name="company_id" groups="base.group_multi_company"/>
                    </search>
                </field>
            </record>

       <record model="ir.ui.view" id="orden_pago_form_view">
            <field name="name">orden_pago.form</field>
            <field name="model">account.orden.pago</field>
            <field name="arch" type="xml">
                <form string="Orden de Pago">
                    <header>
                        <!-- Estado de la orden de pago mostrado como barra de estado -->
                        <field name="state" widget="statusbar"/>
                        <!-- Botón para confirmar la orden de pago, visible en estado 'borrador' -->
                        <button name="confirmar_orden_pago" confirm="¿Está seguro que desea CONFIRMAR LA ORDEN DE PAGO ?"
                                string="Confirmar Orden de Pago" type="object" class="oe_highlight" invisible="state != 'borrador'"/>
                        <!-- Botón para anular la orden de pago, visible en estado 'borrador' -->
                        <button name="%(open_wizard_action_orden_pago_id)d" string="Anular" type="action" class="oe_highlight" invisible="state != 'borrador'"/>
                        <!-- Botón para volver a borrador, invisible en estado 'borrador' -->
                        <button name="set_borrador" string="Volver a borrador" type="object" class="oe_highlight" invisible="state == 'borrador'"/>
                        <!-- Botón para limpiar listado de facturas, invisible por defecto -->
                        <button name="limpiar_facturas" string="Limpiar Listado de Factura" type="object" invisible="1"/>
                        <button name="set_op_code" type="object" string="Asignar cod. OP" invisible="name != False"/>
                    </header>
                    <sheet>
                        <group string="Datos para el Pago" readonly="state != 'borrador'">
                            <group readonly="state != 'borrador'">
                                <!-- Campos de datos para el pago -->
                                <field name="name" invisible="name == False"/>
                                <field name="partner_id" readonly="state != 'borrador'"/>
                                <field name="fecha" readonly="state != 'borrador'"/>
                                <field name="usuario" readonly="state != 'borrador'"/>
                                <field name="currency_id" domain="[('ambito','in',('compra',False))]" readonly="state != 'borrador'"/>
                                <field name="tipo"/>
                                <field name="company_id" readonly="1" options="{'no_create_edit': True, 'no_create': True, 'no_open': True}"/>
                                <field name="moneda_company" invisible="1"/>
                                <field name="move_diferencia_id" invisible="move_diferencia_id == False" readonly="1" force_save="1"/>
                                <field name="existe_pago_gs_extranjero" invisible="1"/>
                                <field name="recibo_proveedor"/>
                                <field name="obs"/>
                                <field name="account_analytic_id" string="Cuenta analitica" />
                            </group>
                            <group string="Montos">
                                <field name="amount"/>
                                <field name="total_pagos"/>
                                <field name="saldo" string="Diferencia"/>
                                <field name="move_id" string="Asiento" invisible="1"/>
                                <field name="method_id" invisible="1"/>
                                <field name="diferencia_cambio" invisible="existe_pago_gs_extranjero == False" readonly="1" force_save="1"/>
                                <field name="diario_diferencia" invisible="existe_pago_gs_extranjero == False" readonly="1" force_save="1"/>
                                <field name="cuenta_diferencia" invisible="existe_pago_gs_extranjero == False" readonly="1" force_save="1"/>
                            </group>
                        </group>
                        <notebook>
                            <page string="Apuntes">
                                <header>
                                    <!-- Botón para asignar facturas, invisible en ciertos estados -->
                                    <button name="retornar_asignacion" string="Asignar facturas" class="btn-primary" type="object"
                                            invisible="state in ('confirmado') or partner_id == False or currency_id == False"/>
                                    <!-- Botón para eliminar asignación de facturas, invisible en ciertos estados -->
                                    <button name="eliminar_asignacion" string="Eliminar facturas" type="object"
                                            invisible="state in ('confirmado') or partner_id == False or currency_id == False"/>
                                </header>
                                <!-- Campo de relación para apuntes, solo lectura fuera de estado borrador -->
                                <field name="orden_pagos_facturas_ids" readonly="state != 'borrador'"
                                       context="{'default_partner_id': partner_id, 'default_currency_id': currency_id, 'default_fecha_pago': fecha}">
                                    <tree editable="bottom">
                                        <field name="move_line_id" column_invisible="parent.tipo == 'move'"
                                               domain="[('no_ver_factura_pago','=',False), ('move_id.state','=','posted') ,('partner_id','child_of',partner_id),('account_id.account_type','=','liability_payable')]"
                                               options="{'no_create_edit': True, 'no_create': True, 'no_open': True}"/>
                                        <field name="invoice_id" column_invisible="parent.tipo == 'move_line'"
                                               domain="[('no_ver_factura_pago','=',False), ('state','=','posted') , ('payment_state','in',('not_paid','partial')),('partner_id','child_of',partner_id),('move_type','=','in_invoice')]"
                                               options="{'no_create_edit': True, 'no_create': True, 'no_open': True}"/>
                                        <field name="date_invoice" string="Fecha Factura"/>
                                        <field name="amount_total" string="Monto Factura" sum="Total de la Factura"/>
                                        <field name="monto" sum="Total del Pago" readonly="amount_total &lt; 0"/>
                                        <field name="monto_gs" sum="Total del Pago" invisible="1"/>
                                        <field name="residual" string="Monto Adeudado" readonly="1"/>
                                        <field name="currency_invoice" invisible="1"/>
                                        <field name="currency_id" invisible="1"/>
                                        <field name="partner_id" invisible="1"/>
                                        <field name="fecha_pago" invisible="1"/>
                                        <field name="nro_factura" invisible="1"/>
                                        <field name="account_payable" optional="show"/>
                                    </tree>
                                </field>
                            </page>
                            <page string="Pagos">
                                <!-- Campo de relación para pagos, solo lectura fuera de estado borrador -->
                                <field name="payment_ids" context="{'form_view_ref':'account_payment_py.pagos_form_views_pagos_id','default_monto_pago':amount, 'default_amount': amount, 'default_payment_type': 'outbound', 'default_partner_id': partner_id, 'default_date': fecha, 'default_partner_type': 'supplier', 'default_orden_pago_id': id, 'default_moneda_pago': currency_id, 'default_ref': obs, 'default_journal_tmp_id': False}"
                                       readonly="state != 'borrador'"/>
                            </page>
                            <page string="Cheques">
                                <!-- Campo de relación para cheques, solo lectura -->
                                <field name="check_ids" readonly="1"/>
                            </page>
                        </notebook>
                    </sheet>
                    <div class="oe_chatter">
                        <field name="message_follower_ids" widget="mail_followers"/>
                        <field name="activity_ids" widget="mail_activity"/>
                        <field name="message_ids" widget="mail_thread"/>
                    </div>
                </form>
            </field>
        </record>


        <record model="ir.ui.view" id="orden_pago_tree_view">
            <field name="name">orden_pago.tree</field>
            <field name="model">account.orden.pago</field>
            <field name="arch" type="xml">
                <tree string="Orden de Pagos" >
                    <field name="name"/>
                    <field name="partner_id"/>
                    <field name="state"/>
                    <field name="fecha"/>
                    <field name="usuario"/>
                    <field name="amount"/>
                </tree>
            </field>
        </record>

        <record model="ir.actions.act_window" id="action_orden_pago">
                <field name="name">Órdenes de Pagos</field>
                <field name="res_model">account.orden.pago</field>
                <field name="view_mode">tree,form</field>
                <field name="view_id" ref="orden_pago_tree_view"/>
        </record>


         <menuitem
            action="action_orden_pago"
            id="orden_pago_menu"
            sequence="20"
            parent="account_check.menu_tesoreria"/>
    </data>
</odoo>
