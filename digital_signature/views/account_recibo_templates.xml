<odoo>
    <template id="template_recibo_comun" name="template_name" inherit_id="account_cobros_py.template_recibo_comun">
    
        <xpath expr="//div[@style='margin-left:20.5cm; margin-top:1.6cm; font-weight:bold;']" position="replace">
            <t t-if="o.company_id.digital_sign">
                <div style="margin-left:19.9cm; display: flex; justify-content: center; align-items: center; margin-top:1.5cm; font-weight:bold;">
                    <img t-att-src="image_data_uri(o.company_id.digital_sign)" style="max-width: 100%; height: 50%;"/>
                </div>
            </t>
            <t t-else="">
                <div style="margin-left:20.5cm; margin-top:1.6cm; font-weight:bold;">
                    <span t-field="o.company_id.sign_by"/>
                </div>
            </t>
        </xpath>

        <xpath expr="//div[@style='margin-left:20.5cm; margin-top:1.6cm; font-weight:bold;']" position="replace">
            <t t-if="o.company_id.digital_sign">
                <div style="margin-left:19.9cm; display: flex; justify-content: center; align-items: center; margin-top:1.5cm; font-weight:bold;">
                    <img t-att-src="image_data_uri(o.company_id.digital_sign)" style="max-width: 100%; height: 50%;"/>
                </div>
            </t>
            <t t-else="">
                <div style="margin-left:20.5cm; margin-top:1.6cm; font-weight:bold;">
                    <span t-field="o.company_id.sign_by"/>
                </div>
            </t>
        </xpath>
    
    </template>
</odoo>
