<odoo>
    <record id="view_order_form" model="ir.ui.view">
        <field name="name">sale.order.form</field>
        <field name="model">sale.order</field>
        <field name="inherit_id" ref="sale.view_order_form"/>
        <field name="arch" type="xml">
            <xpath expr="//header/button[3]" position="attributes">
                <attribute name="invisible">invoice_term_qty > 0</attribute>
            </xpath>

            <field name="date_order" position="after">
                <field name="invoice_term_qty" invisible="1"/>
                <field name="allow_invoice_terms" readonly="1"/>
                <field name="bill_installments" readonly="state == 'sale'"/>
                <field name="installment_qty" invisible="not bill_installments" required="bill_installments" readonly="state == 'sale'"/>
                <field name="installment_amount" invisible="not bill_installments" required="bill_installments" readonly="state == 'sale'"/>
                <button name="generate_invoice_term_installments" string="Generate installments" class="btn btn-info" type="object" invisible="not bill_installments"/>
<!--                <field name="generate_account_move" groups="sati_sale_invoicing_terms.group_invoicing_term_provition_move" string="Generate account provition move" readonly="state == 'sale'"/>-->
                <field name="generate_account_move" string="Generate account provition move" readonly="state == 'sale'"/>
                <field name="contract_file" invisible="not generate_account_move" widget="binary" filename="contract_file_name"/>
            </field>
            <notebook position="inside">
                <page string="Invoice Terms" invisible="not allow_invoice_terms">
                    <field name="invoice_term_ids">
                        <tree editable="bottom">
                            <field name="name" readonly="1"/>
                            <field name="invoice_date" readonly="state == 'invoiced'"/>
                            <field name="invoice_amount" readonly="state == 'invoiced'"/>
                            <field name="state" readonly="1"/>
                            <button name="action_generate_invoice" invisible="state == 'invoiced'" string="Generate Invoice" type="object" class="btn-sm btn-primary" icon="fa-money"/>
                            <button name="open_terms_conditions_wizard" string="Assign conditions" type="object" class="btn-sm btn-success"/>
                            <button name="action_view_invoice_term" string="View" type="object" class="oe_highlight"/>
                        </tree>
                    </field>
                </page>
                <page string="Invoice terms Conditions" invisible="not allow_invoice_terms">
                    <field name="invoice_term_conditions_ids" readonly="1">
                        <tree>
                            <field name="name"/>
                            <field name="user_id"/>
                            <field name="date_deadline"/>
                            <field name="state"/>
                            <field name="condition_activity_type_id" domain="[('res_model','=','sale.invoice.terms.conditions')]"/>
                            <field name="sale_invoice_term_id"/>
                            <button name="action_view_condition" string="View" type="object" class="oe_highlight"/>
                        </tree>
                    </field>
                </page>
            </notebook>
        </field>
    </record>
</odoo>
