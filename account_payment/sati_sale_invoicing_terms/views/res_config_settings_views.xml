<odoo>
    <data>
        <record id="res_config_settings_view_form" model="ir.ui.view">
            <field name="name">res.config.settings.view.form.inherit.account</field>
            <field name="model">res.config.settings</field>
            <field name="inherit_id" ref="account.res_config_settings_view_form"/>
            <field name="arch" type="xml">
                <!-- Ubicamos el bloque específico -->
                <xpath expr="//block[@id='print_vendor_checks_setting_container']" position="after">
                    <block title="Configuration for contract account provitions" id="contract_provitions_setting_container">
                        <div class="row mt16 o_settings_container">
                            <div class="col-12 col-lg-6 o_setting_box">
                                <div class="o_setting_left_pane"/>
                                <div class="o_setting_right_pane">
                                    <div class="content-group">
                                        <div class="row mt8">
                                            <label for="contract_account_id" class="col-lg-4 o_light_label"/>
                                            <field name="contract_account_id"/>
                                        </div>
                                        <div class="row mt8">
                                            <label for="provition_account_id" class="col-lg-4 o_light_label"/>
                                            <field name="provition_account_id"/>
                                        </div>
                                        <div class="row mt8">
                                            <label for="provition_journal_id" class="col-lg-4 o_light_label"/>
                                            <field name="provition_journal_id"/>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </block>
                </xpath>
            </field>
        </record>
    </data>
</odoo>
