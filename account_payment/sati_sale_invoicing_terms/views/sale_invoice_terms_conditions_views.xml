<odoo>
    <!-- Form view -->
    <record id="view_invoice_term_condition_form" model="ir.ui.view">
        <field name="name">sale.invoice.terms.conditions.form</field>
        <field name="model">sale.invoice.terms.conditions</field>
        <field name="arch" type="xml">
            <form string="Invoice Term Conditions">
                <header>
                    <field name="state" widget="statusbar"/>
                    <button name="set_done" string="Set done" type="object" class="btn btn-success" invisible="state != 'pending'"/>
                </header>
                <sheet>
                    <group string="Sale info">
                        <field name="name"/>
                        <field name="sale_order_id"/>
                        <field name="user_id"/>
                        <field name="date_deadline"/>
                        <field name="condition_activity_type_id" domain="[('res_model','=','sale.invoice.terms.conditions')]"/>
                        <field name="sale_invoice_term_id"/>
                        <field name="partner_id" readonly="1"/>
                    </group>
                    <group string="Accounting info">
                        <field name="analytic_account_id" invisible="not analytic_account_id"/>
                        <field name="invoice_id" invisible="not invoice_id"/>
                    </group>
                </sheet>
                <div class="oe_chatter">
                    <field name="message_follower_ids" widget="mail_followers"/>
                    <field name="activity_ids" widget="mail_activity"/>
                    <field name="message_ids" widget="mail_thread"/>
                </div>
            </form>
        </field>
    </record>

    <!-- List view -->
    <record id="view_sale_invoice_term_conditions_tree" model="ir.ui.view">
        <field name="name">sale.invoice.terms.conditions.tree</field>
        <field name="model">sale.invoice.terms.conditions</field>
        <field name="arch" type="xml">
            <tree>
                <field name="name"/>
                <field name="analytic_account_id"/>
                <field name="user_id"/>
                <field name="date_deadline"/>
                <field name="sale_order_id"/>
                <field name="condition_activity_type_id"/>
                <field name="sale_invoice_term_id"/>
                <field name="state"/>
            </tree>
        </field>
    </record>

    <!-- Pivot view -->
    <record id="view_sale_invoice_term_condition_pivot" model="ir.ui.view">
        <field name="name">sale.invoice.terms.conditions.pivot</field>
        <field name="model">sale.invoice.terms.conditions</field>
        <field name="arch" type="xml">
            <pivot string="Invoice Terms">
                <field name="analytic_account_id" type="row"/>
            </pivot>
        </field>
    </record>

    <!-- Search view -->
    <record id="view_sale_invoice_term_conditions_search" model="ir.ui.view">
        <field name="name">sale.invoice.terms.conditions.search</field>
        <field name="model">sale.invoice.terms.conditions</field>
        <field name="arch" type="xml">
            <search string="Search Invoice Term Conditions">
                <field name="name"/>
                <field name="sale_order_id"/>
                <field name="partner_id"/>
                <field name="invoice_id"/>
                <field name="user_id"/>
                <separator/>
                <filter string="Pending" name="is_pending" domain="[('state','=','pending')]"/>
                <filter string="Done" name="is_done" domain="[('state','=','done')]"/>
                <group expand="0" string="Group By">
                    <filter name="state" string="Invoice state" context="{'group_by':'state'}"/>
                    <filter name="user_id" string="Responsible" context="{'group_by':'user_id'}"/>
                    <filter name="partner_id" string="Partner" context="{'group_by':'partner_id'}"/>
                    <filter name="invoice_id" string="Invoice" context="{'group_by':'invoice_id'}"/>
                    <filter name="saleorder" string="Sale Order" context="{'group_by':'sale_order_id'}"/>
                    <filter name="date" string="Date deadline" context="{'group_by':'date_deadline'}"/>
                </group>
            </search>
        </field>
    </record>

    <!-- Window action -->
    <record id="sale_invoice_term_conditions_action" model="ir.actions.act_window">
        <field name="name">Invoice Terms Conditions</field>
        <field name="res_model">sale.invoice.terms.conditions</field>
        <field name="view_mode">tree,form,pivot</field>
        <field name="search_view_id" ref="view_sale_invoice_term_conditions_search"/>
        <field name="context">{'group_by':'sale_order_id'}</field>
    </record>

    <!-- Menu item -->
    <menuitem id="menu_sale_invoice_condition_terms"
              name="Invoice Terms Conditions"
              parent="sale.sale_order_menu"
              action="sale_invoice_term_conditions_action"
              sequence="25"/>
</odoo>
