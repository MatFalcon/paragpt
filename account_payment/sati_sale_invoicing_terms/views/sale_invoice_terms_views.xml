<odoo>
    <!-- Form view -->
    <record id="view_invoice_term_form" model="ir.ui.view">
        <field name="name">sale.invoice.terms.form</field>
        <field name="model">sale.invoice.terms</field>
        <field name="arch" type="xml">
            <form string="Invoice Term">
                <header>
                    <field name="state" widget="statusbar"/>
                </header>
                <sheet>
                    <group string="Sale info">
                        <field name="name" readonly="1"/>
                        <field name="sale_order_id" readonly="1"/>
                        <field name="invoice_date" readonly="1"/>
                        <field name="invoice_amount" readonly="1"/>
                        <field name="invoice_id" readonly="1"/>
                    </group>
                    <group string="Accounting info">
                        <field name="analytic_account_id" invisible="not analytic_account_id"/>
                        <field name="provition_move_id" invisible="not provition_move_id"/>
                        <field name="provition_cancel_move_id" invisible="not provition_cancel_move_id"/>
                    </group>
                </sheet>
                <div class="oe_chatter">
                    <field name="message_follower_ids" widget="mail_followers"/>
                    <field name="activity_ids" widget="mail_activity"/>
                    <field name="message_ids" widget="mail_thread"/>
                </div>
            </form>
        </field>
    </record>

    <!-- List view -->
    <record id="view_sale_invoice_term_tree" model="ir.ui.view">
        <field name="name">sale.invoice.terms.tree</field>
        <field name="model">sale.invoice.terms</field>
        <field name="arch" type="xml">
            <tree>
                <field name="name"/>
                <field name="analytic_account_id" readonly="state == 'invoiced'"/>
                <field name="sale_order_id" readonly="state == 'invoiced'"/>
                <field name="invoice_date" readonly="state == 'invoiced'"/>
                <field name="invoice_amount" readonly="state == 'invoiced'"/>
                <field name="state"/>
            </tree>
        </field>
    </record>

    <!-- Pivot view -->
    <record id="view_sale_invoice_term_pivot" model="ir.ui.view">
        <field name="name">sale.invoice.terms.pivot</field>
        <field name="model">sale.invoice.terms</field>
        <field name="arch" type="xml">
            <pivot string="Invoice Terms">
                <field name="sale_order_id" type="row"/>
                <field name="invoice_amount" type="measure"/>
            </pivot>
        </field>
    </record>

    <!-- Search view -->
    <record id="view_sale_invoice_term_search" model="ir.ui.view">
        <field name="name">sale.invoice.terms.search</field>
        <field name="model">sale.invoice.terms</field>
        <field name="arch" type="xml">
            <search string="Search Invoice Term">
                <field name="sale_order_id"/>
                <field name="invoice_date"/>
                <field name="partner_id"/>
                <field name="invoice_id"/>
                <separator/>
                <filter string="Is Invoiced" name="is_invoiced_true" domain="[('state','=','invoiced')]"/>
                <filter string="Not Invoiced" name="is_invoiced_false" domain="[('state','=','to_invoice')]"/>
                <group expand="0" string="Group By">
                    <filter name="state" string="Invoice state" context="{'group_by':'state'}"/>
                    <filter name="partner_id" string="Partner" context="{'group_by':'partner_id'}"/>
                    <filter name="invoice_id" string="Invoice" context="{'group_by':'invoice_id'}"/>
                    <filter name="saleorder" string="Sale Order" context="{'group_by':'sale_order_id'}"/>
                    <filter name="invoice date" string="Invoice Date" context="{'group_by':'invoice_date'}"/>
                </group>
            </search>
        </field>
    </record>

    <!-- Window action -->
    <record id="action_sale_invoice_terms" model="ir.actions.act_window">
        <field name="name">Invoice Terms</field>
        <field name="res_model">sale.invoice.terms</field>
        <field name="view_mode">tree,form,pivot</field>
        <field name="search_view_id" ref="view_sale_invoice_term_search"/>
        <field name="context">{'group_by':'sale_order_id'}</field>
    </record>

    <!-- Menu item -->
    <menuitem id="menu_sale_invoice_terms"
              name="Invoice Terms"
              parent="sale.sale_order_menu"
              action="action_sale_invoice_terms"
              sequence="20"/>
</odoo>
