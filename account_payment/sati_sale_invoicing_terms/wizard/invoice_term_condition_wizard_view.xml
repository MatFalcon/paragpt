<odoo>
    <data>
        <record id="view_invoice_terms_conditions_wizard" model="ir.ui.view">
            <field name="name">invoice.terms.conditions.wizard.form</field>
            <field name="model">invoice.terms.conditions.wizard</field>
            <field name="arch" type="xml">
                <form string="Assign conditions">
                    <sheet>
                        <group>
                            <field name="sale_invoice_term_id" readonly="1"/>
                            <field name="name"/>
                            <field name="user_id"/>
                            <field name="date_deadline"/>
                            <field name="condition_activity_type_id" domain="[('res_model','=','sale.invoice.terms.conditions')]"/>
                        </group>
                    </sheet>
                    <footer>
                        <button name="action_save" string="Confirm" type="object" class="oe_highlight"/>
                        <button string="Cancel" class="btn-secondary" special="cancel"/>
                    </footer>
                </form>
            </field>
        </record>

    </data>
</odoo>