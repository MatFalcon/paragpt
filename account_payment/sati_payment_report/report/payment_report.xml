<odoo>
    <template id="report_payment">
        <t t-call="web.html_container">
            <t t-call="web.external_layout">
                <link rel="stylesheet" href="/sati_payment_report/static/src/css/estilo.css"/>
                <div class="page">
                    <div class="row">
                        <div class="col-12">
                            <h3 class="mb-3">Reporte de pagos</h3>
                        </div>
                    </div>
                    <hr/>
                    <div class="row mt32 mb32">
                        <div class="col-6">
                            <strong>Fecha Desde: </strong><span t-esc="date_from"/><br/>
                            <strong>Fecha Hasta: </strong><span t-esc="date_to"/>
                        </div>
                    </div>
                    <!-- Detalle por cada diario -->
                    <t t-foreach="journal_ids" t-as="journal">
                        <div class="row">
                            <div class="col-12">
                                <h3 t-esc="journal.name"/>
                            </div>
                        </div>
                        <table class="table table-condensed">
                           <thead>
                                <tr>
                                    <th style="width: 10%;">Fecha</th>
                                    <th style="width: 12%;">Diario</th>
                                    <th>Partner</th>
                                    <th>Moneda</th>
                                    <th>Documento</th>
                                    <th style="width: 12%;">Factura</th>
                                    <t t-if="'Cheque' in journal.name or 'CHEQUE' in journal.name">
                                        <th style="width: 10%;">Cheque</th>
                                    </t>
                                    <th>Recibo</th>
                                    <th>Monto Moneda Local</th>
                                    <th>Monto Moneda Extranjera</th>
                                </tr>
                            </thead>
                            <tbody>
                                <t t-foreach="payments_grouped[journal.id]" t-as="payment">
                                    <tr>
                                        <td t-esc="payment.date"/>
                                        <td t-esc="payment.journal_id.name"/>
                                        <td style="text-align: center;">
                                            <t t-if="payment.partner_id and payment.partner_id.name">
                                                <t t-esc="payment.partner_id.name"/>
                                            </t>
                                            <t t-else="">
                                                <span>-</span>
                                            </t>
                                        </td>
                                        <td t-esc="payment.currency_id.name"/>
                                        <td t-esc="payment.name"/>
                                        <td>
                                            <t t-foreach="payment.reconciled_invoice_ids.mapped('nro_factura')" t-as="nro_factura">
                                                <t t-esc="nro_factura"/><br/>
                                            </t>
                                        </td>
                                        <t t-if="'Cheque' in journal.name or 'CHEQUE' in journal.name">
                                            <td>
                                                <t t-foreach="payment.received_third_check_ids.mapped('number')" t-as="cheque">
                                                    <t t-esc="cheque"/><br/>
                                                </t>
                                            </td>
                                        </t>
                                        <td style="text-align: center;" t-esc="payment.recibo_id.name or '-'"/>
                                        <td t-esc="payment.amount_local"
                                            t-options='{"widget": "monetary", "display_currency": payment.company_id.currency_id}'/>
                                        <td t-esc="payment.amount_currency"
                                            t-options='{"widget": "monetary", "display_currency": payment.currency_id}'/>
                                    </tr>
                                </t>
                            </tbody>
                        </table>
                    </t>
                    <!-- Sección de totales globales -->
                    <div class="row">
                        <div class="col-12">
                            <h3>Totales</h3>
                        </div>
                    </div>
                    <!-- Definir moneda por defecto para los totales. Se intenta usar la moneda del primer diario o, si no existe, la de la compañía -->
                    <t t-set="default_currency" t-value="journal_ids and journal_ids[0].company_id.currency_id or request.env.company.currency_id"/>
                    <table class="table table-condensed">
                        <thead>
                            <tr>
                                <th>Diario</th>
                                <th>Total moneda local convertido</th>
                                <th>Total moneda extranjera</th>
                                <th>Total moneda local</th>
                            </tr>
                        </thead>
                        <tbody>
                            <t t-foreach="journal_ids" t-as="journal">
                                <tr>
                                    <td class="text-right"><strong t-esc="journal.name"/></td>
                                    <td t-esc="journal_totals_local[journal.id]"
                                        t-options='{"widget": "monetary", "display_currency": journal.company_id.currency_id}'/>
                                    <td t-esc="journal_totals_currency[journal.id]"
                                        t-options='{"widget": "monetary", "display_currency": journal.currency_id if journal.currency_id else journal.company_id.currency_id}'/>
                                    <td t-esc="journal_totals_gs[journal.id]"
                                        t-options='{"widget": "monetary", "display_currency": journal.company_id.currency_id}'/>
                                </tr>
                            </t>
                            <tr>
                                <td class="text-left"><strong>Totales por Diario:</strong></td>
                                <td>
                                    <t t-if="default_currency">
                                        <span t-esc="total_local" t-options='{"widget": "monetary", "display_currency": default_currency}'/>
                                    </t>
                                    <t t-else="">
                                        <span t-esc="total_local"/>
                                    </t>
                                </td>
                                <td>
                                    <t t-if="default_currency">
                                        <span t-esc="total_currency" t-options='{"widget": "monetary", "display_currency": default_currency}'/>
                                    </t>
                                    <t t-else="">
                                        <span t-esc="total_currency"/>
                                    </t>
                                </td>
                                <td>
                                    <t t-if="default_currency">
                                        <span t-esc="total_totales" t-options='{"widget": "monetary", "display_currency": default_currency}'/>
                                    </t>
                                    <t t-else="">
                                        <span t-esc="total_totales"/>
                                    </t>
                                </td>
                            </tr>
                        </tbody>
                    </table>
                </div>
            </t>
        </t>
    </template>
</odoo>
