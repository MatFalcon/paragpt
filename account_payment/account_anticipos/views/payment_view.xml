<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <record id="view_account_payment_form_inh_anticipos" model="ir.ui.view">
            <field name="name">view.payment.inh.anticipos</field>
            <field name="model">account.payment</field>
            <field name="type">form</field>
            <field name="inherit_id" ref="account.view_account_payment_form"/>
            <field name="arch" type="xml">
                <xpath expr="//field[@name='partner_id']" position="after">
                    <field invisible="1" name="pago_anticipo"/>
                    <field invisible="'pago_anticipo', '=', False" name="saldo_anticipo" style="color:red"/>
                    <field invisible="'pago_anticipo', '=', False" name="anticipo_lines">
                        <tree>
                            <field name="date" style="color:red"/>
                            <field name="balance" style="color:red"/>
                        </tree></field>
                </xpath></field>
        </record>
        <record id="view_account_payment_form_inh_anticipos_orden_pago" model="ir.ui.view">
            <field name="name">view.payment.inh.anticipos.orden.pago</field>
            <field name="model">account.payment</field>
            <field name="type">form</field>
            <field name="inherit_id" ref="account_payment_py.pagos_form_views_pagos_id"/>
            <field name="arch" type="xml">
                <xpath expr="//field[@name='partner_id']" position="after">
                    <field invisible="1" name="pago_anticipo"/>
                    <field invisible="'pago_anticipo', '=', False" name="saldo_anticipo" style="color:red"/>
                    <field invisible="'pago_anticipo', '=', False" name="anticipo_lines">
                        <tree>
                            <field name="date" style="color:red"/>
                            <field name="balance" style="color:red"/>
                        </tree></field>
                </xpath></field>
        </record>
        <record id="view_account_payment_form_inh_anticipos_recibos" model="ir.ui.view">
            <field name="name">view.payment.inh.anticipos.recibos</field>
            <field name="model">account.payment</field>
            <field name="type">form</field>
            <field name="inherit_id" ref="account_cobros_py.cobros_form_view_id"/>
            <field name="arch" type="xml">
                <xpath expr="//field[@name='partner_id']" position="after">
                    <field invisible="1" name="pago_anticipo"/>
                    <field invisible="'pago_anticipo', '=', False" name="saldo_anticipo" style="color:red"/>
                    <field invisible="'pago_anticipo', '=', False" name="anticipo_lines">
                        <tree>
                            <field name="date" style="color:red"/>
                            <field name="balance" style="color:red"/>
                        </tree></field>
                </xpath></field>
        </record>
    </data>
</odoo>
