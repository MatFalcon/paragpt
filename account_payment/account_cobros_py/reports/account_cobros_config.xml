<odoo>
    <data>
        <!--Hoja para la caja -->
        <record id="paperformat_recibo" model="report.paperformat">
            <field name="name">A4-caja</field>
            <field name="default" eval="True"/>
            <field name="format">custom</field>
            <field name="page_height">297</field>
            <field name="page_width">210</field>
            <field name="orientation">Landscape</field>
            <field name="margin_top">30</field>
            <field name="margin_bottom">10</field>
            <field name="margin_left">10</field>
            <field name="margin_right">5</field>
            <field name="header_line" eval="False"/>
            <field name="header_spacing">20</field>
            <field name="dpi">90</field>
        </record>
        <!--Hoja para la Cobranza-->
        <record id="paperformat_cobranza" model="report.paperformat">
            <field name="name">A4-cobranza</field>
            <field name="default" eval="True"/>
            <field name="format">custom</field>
            <field name="page_height">297</field>
            <field name="page_width">210</field>
            <field name="orientation">Landscape</field>
            <field name="margin_top">40</field>
            <field name="margin_bottom">10</field>
            <field name="margin_left">10</field>
            <field name="margin_right">5</field>
            <field name="header_line" eval="False"/>
            <field name="header_spacing">35</field>
            <field name="dpi">90</field>
        </record>
    
        <!--Formato del recibo-->
        <record id="paperformat_reporte" model="report.paperformat">
            <field name="name">A4-recibo</field>
            <field name="default" eval="True"/>
            <field name="format">custom</field>
            <field name="page_height">297</field>
            <field name="page_width">210</field>
            <field name="orientation">Landscape</field>
            <field name="margin_top">30</field>
            <field name="margin_bottom">10</field>
            <field name="margin_left">10</field>
            <field name="margin_right">5</field>
            <field name="header_spacing">20</field>
            <field name="header_line" eval="False"/>
            <field name="dpi">90</field>
        </record>
    
        <!--Cobranza-->
        <record id="report_cobranzas_action" model="ir.actions.report">
            <field name="name">Reporte de Cobranzas</field>
            <field name="model">account_cobros.wizard.reporte.cobranzas</field>
            <field name="report_name">account_cobros_py.report_cobranzas</field>
            <field name="report_file">account_cobros_py.report_cobranzas</field>
            <field name="report_type">qweb-pdf</field>
            <field name="print_report_name">('object', 'Reporte de Cobranzas')</field>
            <field name="paperformat_id" ref="account_cobros_py.paperformat_cobranza"/>
        </record>
    
        <record id="report_account_cobros_py_caja_action" model="ir.actions.report">
            <field name="name">Reporte de la Caja</field>
            <field name="model">ruc.cajas</field>
            <field name="report_name">account_cobros_py.report_caja</field>
            <field name="report_file">account_cobros_py.report_caja</field>
            <field name="report_type">qweb-pdf</field>
            <field name="print_report_name">('object', 'Reporte de la Caja')</field>
            <field name="paperformat_id" ref="account_cobros_py.paperformat_recibo"/>
        </record>
    
        <!--Formato Recibo Ecoenergia-->
        <record id="paperformat_recibo_ecoenergia" model="report.paperformat">
            <field name="name">Formato Recibo Ecoenergia</field>
            <field name="default" eval="True"/>
            <field name="format">custom</field>
            <field name="page_height">356</field>
            <field name="page_width">210</field>
            <field name="orientation">Portrait</field>
            <field name="margin_top">10</field>
            <field name="margin_bottom">10</field>
            <field name="margin_left">10</field>
            <field name="margin_right">10</field>
            <field name="header_line" eval="False"/>
            <field name="header_spacing">0</field>
            <field name="dpi">90</field>
        </record>
    
        <!--Botón del recibo-->
        <record id="report_regier_recibo_comun" model="ir.actions.report">
            <field name="name">Recibo Comun</field>
            <field name="model">account.recibo</field>
            <field name="report_name">account_cobros_py.template_recibo_comun</field>
            <field name="report_file">account_cobros_py.template_recibo_comun</field>
            <field name="report_type">qweb-pdf</field>
            <field name="print_report_name">('Recibo Comun')</field>
            <field name="paperformat_id" ref="account_cobros_py.paperformat_recibo_ecoenergia"/>
        </record>

        <record id="report_recibo_cobranza" model="ir.actions.report">
            <field name="name">Recibo</field>
            <field name="model">account.recibo</field>
            <field name="report_name">account_cobros_py.template_recibo</field>
            <field name="report_file">account_cobros_py.template_recibo</field>
            <field name="report_type">qweb-pdf</field>
            <field name="binding_model_id" ref="account_cobros_py.model_account_recibo" />
            <field name="print_report_name">('Recibo')</field>
        </record>
        
    </data>
</odoo>
