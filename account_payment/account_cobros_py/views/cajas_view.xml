<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <menuitem action="caja_chica.action_cajas" id="menu_action_cajas" parent="account.menu_finance_receivables" />

        <record id="account_invoice_line_operating_unit_inh" model="ir.ui.view">
                <field name="name">ruc.cajas</field>
                <field name="model">ruc.cajas</field>
                <field name="inherit_id" ref="caja_chica.cajas_form_view"/>
                <field name="arch" type="xml">
                    <xpath expr="//field[@name='movimientos_ids']/tree" position="inside">
                        <field name="recibo_id"/>
                    </xpath>
                </field>
        </record>

         <record model="ir.ui.view" id="ruc_caja_detalle_form_view">
            <field name="name">ruc cajas detalle form</field>
            <field name="model">ruc.caja.detalle</field>
            <field name="arch" type="xml">
                <form string="Movimientos">
                    <sheet>
                        <group>
                            <field name="recibo_id"/>
                            <field name="cliente"/>
                            <field name="cobro_efectivo"/>
                            <field name="cobro_retencion_monto"/>
                            <field name="cobro_cheque"/>
                        </group>
                    </sheet>
                </form>
            </field>
        </record>

        <record model="ir.ui.view" id="ruc_cajas_search_view">
            <field name="name">ruc.cajas.search</field>
            <field name="model">ruc.cajas</field>
            <field name="arch" type="xml">
                <search>
                    <field name="usuario" string="Corbrador"/>
                    <filter string="Estado" name="state"  context="{'group_by':'state'}"/>
                    <filter string="Cobrador" name="usuario"  context="{'group_by':'usuario'}"/>
                </search>
            </field>
        </record>
    </data>
</odoo>