        <record id="view_move_form_inherited_recibos_statusbar" model="ir.ui.view">
            <field name="name">account.move.form.recibos.vinculados.statusbar</field>
            <field name="model">account.move</field>
            <field name="inherit_id" ref="account.view_move_form"/>
            <field name="arch" type="xml">
                <!-- Agregar contador junto a las Órdenes de Venta -->
                <xpath expr="//button[@name='action_view_source_sale_orders']" position="after">
                    <button name="action_open_recibos_vinculados"
                            type="object"
                            string="Recibos Vinculados"
                            icon="fa-file"
                            class="oe_stat_button">
                        <field name="recibos_vinculados_count" widget="statinfo" />
                    </button>
                </xpath>
            </field>
        </record>

