<odoo>
    <template id="payment_report">
        <t t-call="web.html_container">
            <t t-foreach="docs" t-as="o">
                <t t-call="web.external_layout">
                    <div class="page">
                       <link rel="stylesheet" href="/account_payment_py/static/src/css/orden_pago.css"/>
                           <h2>Orden de Pago: <span t-field="o.name"/> </h2>
                           <div class="row">

                            <div class="col-6">
                              <span class="negrita">Fecha:</span>  <span t-field="o.fecha"/>
                              <br/>
                              <span class="negrita">Moneda:</span>  <span t-field="o.currency_id.name"/>
                            </div>
                            <div class="col-6">
                              <span class="negrita">Proveedor:</span>
                              <span t-field="o.partner_id.name" style="background-color: #FFFF00; font-size: 19px; font-weight: bold;"/>
                              <br/>

                              <span class="negrita">Titular:</span>&amp;nbsp;
                              <span t-field="o.partner_id.bank_ids.acc_holder_name" style="font-size: 19px; font-weight: bold;"/>
                              <br/>

                              <span class="negrita">Banco:</span>&amp;nbsp;
                              <span t-field="o.partner_id.bank_ids.bank_name" style="font-size: 19px; font-weight: bold;"/>
                              <br/>
                              <span class="negrita">Cuenta:</span>&amp;nbsp;
                              <span t-field="o.partner_id.bank_ids.acc_number" style="font-size: 19px; font-weight: bold;"/>
                              <br/>
                              <span class="negrita">RUC:</span>&amp;nbsp;
                              <span t-field="o.partner_id.rucdv" style="font-size: 19px; font-weight: bold;"/>
                            </div>
                            </div>
                            <br/>
                       <br/>
                       <h3>Detalles Facturas</h3>
                       <table>
                           <thead>
                               <tr>
                                   <th>Nro. Factura</th>
                                   <th>Fecha Factura</th>
                                   <th>Pago</th>
                                   <th>Monto Factura</th>
                               </tr>
                           </thead>
                           <tbody>
                               <t t-set="total_monto" t-value="0"/>
                               <t t-set="total_amount" t-value="0"/>
                               <t t-foreach="o.orden_pagos_facturas_ids" t-as="f">
                                   <t t-set="total_monto" t-value="total_monto+f.monto"/>
                                   <t t-set="total_amount" t-value="total_amount+f.amount_total"/>
                                   <tr>
                                       <td><span t-field="f.invoice_id.nro_factura"/> </td>
                                       <td style="text-align:right;width:40px;"><span t-field="f.date_invoice"/> </td>

                                       <!-- c -->
                                       <t t-if=" o.currency_id.name != 'PYG' ">
                                           <td style="text-align:right;"><span t-esc="o.agregar_punto_de_miles(f.monto,o.currency_id.name)"/> </td>
                                            <td style="text-align:right;"><span t-esc="o.agregar_punto_de_miles(f.amount_total,o.currency_id.name)"/> </td>
<!--                                            <td><span t-esc="o.puntodemiles(o.cambiapuntoporcoma(f.monto))"/> </td>-->
<!--                                           <td><span t-esc="o.puntodemiles(o.cambiapuntoporcoma(o.sacasimbolo_(f.amount_total)))"/> </td>-->
                                       </t>
                                       <t t-else="">
                                            <td style="text-align:right; width:120px;"><span t-esc="o.agregar_punto_de_miles(f.monto,o.currency_id.name)"/> </td>
                                            <td style="text-align:right;"><span t-esc="o.agregar_punto_de_miles(f.amount_total,o.currency_id.name)"/> </td>
                                       </t>
                                       <!-- -->


                                       <!--<td><span t-esc="o.agregar_punto_de_miles(f.monto,o.currency_id)" /> </td>-->
                                       <!--<td><span t-esc="o.agregar_punto_de_miles(f.amount_total,o.currency_id)" /> </td>-->
                                   </tr>

                               </t>
                               <div class="negrita">
                                   <td style="font-weight:bold;" colspan="2">Totales</td>
                                   <t t-if="o.currency_id.name != 'PYG' ">
                                       <td style="text-align:right; font-weight:bold;"><span t-esc="o.agregar_punto_de_miles(total_monto,o.currency_id.name)"/> </td>
                                       <td style="text-align:right; font-weight:bold;"><span t-esc="o.agregar_punto_de_miles(total_amount,o.currency_id.name)"/> </td>
                                   </t>
                                   <t t-else="">
                                        <td style="text-align:right; font-weight:bold;"><span t-esc="o.agregar_punto_de_miles(total_monto,o.currency_id.name)"/> </td>
                                        <td style="text-align:right; font-weight:bold;"><span t-esc="o.agregar_punto_de_miles(total_amount,o.currency_id.name)"/> </td>
                                   </t>
                                       <!-- -->

                                   <!--<td ><span t-esc="o.agregar_punto_de_miles(total_monto,o.currency_id)"/> </td>-->
                                   <!--<td ><span t-esc="o.agregar_punto_de_miles(total_amount,o.currency_id)"/> </td>-->
                               </div>
                           </tbody>
                       </table>
                        <br/>
                       <h3>Detalles Pagos</h3>
                       <table>
                           <thead>
                               <tr>
                                    <th>Forma de Pago</th>
                                    <th>Nro.Chq/Trf</th>
                                    <th>Recibo</th>
                                    <th>Monto a Pagar</th>
                               </tr>
                           </thead>
                           <tbody>
                               <t t-set="total_pago" t-value="0"/>
                               <tr t-foreach="o.payment_ids" t-as="pago">
                                   <t t-set="total_pago" t-value="total_pago+pago.amount"/>
                                   <td><span t-field="pago.journal_id.name"/> </td>


                                   <t style="text-align:right;" t-if="pago.numero_cheque_pago">
                                       <td style="text-align: right;"><span style="text-align:right;" t-field="pago.numero_cheque_pago"/> </td>
                                   </t>
                                   <t t-else="">
                                       <td/>
                                   </t>
                                   <t style="text-align: right;" t-if="pago.nro_recibo_pago">
                                       <td style="text-align: right;"><span style="text-align: right;" t-field="pago.nro_recibo_pago"/> </td>
                                   </t>
                                   <t t-else="">
                                       <td/>
                                   </t>
                                   <t t-if="o.currency_id.name != 'PYG' ">
                                       <td><span t-esc="o.puntodemiles(o.cambiapuntoporcoma(pago.amount))"/> </td>
                                   </t>
                                   <t t-else="">
                                       <td><span t-esc="o.agregar_punto_de_miles(pago.amount,o.currency_id)"/> </td>
                                   </t>

                                   <!--<td><span t-esc="o.agregar_punto_de_miles(pago.amount,o.currency_id)"/> </td>-->
                               </tr>
                                <tr>
                                    <td colspan="3"><span>Total Pago</span></td>
                                    <!-- c -->
                                    <t t-if="o.currency_id.name != 'PYG' ">
                                        <!--<td colspan="1" style="background-color: #00FF00; text-align:right;"><span t-esc="o.puntodemiles(o.cambiapuntoporcoma(total_pago))"/> </td>-->
                                        <td style="background-color: #00FF00; text-align:right;"><span t-esc="'{:,.2f}'.format(pago.amount).replace(',', 'X').replace('.', ',').replace('X', '.')"/></td>
                                    </t>
                                    <t t-else="">
                                        <td colspan="1" style="background-color: #00FF00; text-align:right;"><span t-esc="o.agregar_punto_de_miles(total_pago,o.currency_id)"/></td>
                                    </t>
                                </tr>

                               <!--<td><span t-esc="o.agregar_punto_de_miles(total_pago,o.currency_id)"/></td>-->


                           </tbody>
                       </table>
                       <br/>
                       <br/>
                       <div class="row">
                           <div class="col-6">
                               <b><span>Hecho Por: </span></b>
                           </div>
                           <br/>
                          <div class="col-6">
                               <b><span>Recibido Por: </span></b>
                           </div>
                        </div>

                       <br/>
                       <div class="row">
                           <div class="col-6">
                               <b><span>Autorizado Por: </span></b>
                           </div>
                           <br/>
                          <div class="col-6">
                               <b><span>Firma: </span></b>
                           </div>
                        </div>
                       <br/>
                       <div class="row">
                           <div class="col-6">
                               <b>Observaciones:</b>
                               <p t-raw="o.obs"/>
                           </div>
                           <div class="col-6">
                               <b><span>CI:</span></b>
                           </div>
                       </div>
                   </div>
                </t>
            </t>
        </t>
    </template>
</odoo>