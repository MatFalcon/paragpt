<odoo>
    <data>
         <record id="view_account_payment_form_inh_orden_pago" model="ir.ui.view">
            <field name="name">view.payment.inh.orden.pago</field>
            <field name="model">account.payment</field>
            <field name="type">form</field>
            <field name="inherit_id" ref="account.view_account_payment_form"/>
            <field name="arch" type="xml">
                <xpath expr="//header" position="attributes">
                    <attribute name="invisible">orden_pago_id != False</attribute>
                </xpath>
                <xpath expr="//field[@name='date']" position="before">
                        <field name="orden_pago_id" invisible="payment_type != 'outbound'"/>
                        <field name="moneda_pago" string="Moneda Alternativa de Pago "/>
                        <field name="monto_moneda_pago" string="Monto Alternativo de Pago"/>
                        <field name="cotizacion"/>
                        <field name="cheque_propio" invisible="1"/>
                        <field name="checkbook_id" invisible="cheque_propio != True" domain="[('journal_id','=',journal_id),('state','=','active')]"/>
                        <field name="numero_cheque_pago" invisible="checkbook_id == False" required="checkbook_id != False"/>
                        <field name="fecha_cheque_pago" string="Fecha Emisión" force_save="1" invisible="checkbook_id == False" required="checkbook_id != False"/>
                        <field name="fecha_cheque_diferido" string="Fecha de Pago" force_save="1" invisible="checkbook_id == False" required="checkbook_id != False"/>
                        <field name="observaciones" invisible="1"/>
                        <field name="moneda_pago" string="Moneda Alternativa de Pago" invisible="checkbook_id == False" required="checkbook_id != False"/>
                        <field name="monto_moneda_pago" string="Monto Alternativo de Pago" invisible="checkbook_id == False" required="checkbook_id != False"/>
                        <field name="cotizacion" invisible="checkbook_id == False" required="checkbook_id != False"/>
                </xpath>
            </field>
        </record>

        <record id="view_account_payment_search_inh_op" model="ir.ui.view">
            <field name="name">view_account_payment_search_inh_op</field>
            <field name="model">account.payment</field>
            <field name="type">search</field>
            <field name="inherit_id" ref="account.view_account_payment_search"/>
            <field name="arch" type="xml">
                <xpath expr="//field[@name='journal_id']" position="after">
                    <field name="orden_pago_id" />
                </xpath>
            </field>
        </record>
    </data>
</odoo>
