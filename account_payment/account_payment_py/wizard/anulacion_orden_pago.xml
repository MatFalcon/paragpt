<odoo>
    <data>
        <record id="wizard_orden_pago" model="ir.ui.view">
            <field name="name">orden.pago.wizard</field>
            <field name="model">orden.pago.wizard</field>
            <field name="arch" type="xml">
                <form string="Motivo de Anulacion">
                    <group>
                        <field name="motivo_anulacion"/>
                    </group>
                    <footer>
                        <button class="oe_highlight" name="set_motivo_anulacion" string="Confirmar" type="object"/>
                        <button string="Cancelar" special="cancel"/>
                    </footer>
                </form>
            </field>
        </record>

        <record id="open_wizard_action_orden_pago_id" model="ir.actions.act_window">
            <field name="name">Motivo Anulacion</field>
            <field name="type">ir.actions.act_window</field>
            <field name="res_model">orden.pago.wizard</field>

            <field name="view_mode">form</field>
            <field name="view_id" ref="wizard_orden_pago"/>
            <field name="target">new</field>
            <field name="context">{'default_orden_pago_id':active_id}</field>
        </record>

    </data>
</odoo>