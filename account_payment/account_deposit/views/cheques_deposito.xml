<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <record model="ir.ui.view" id="vista_cheques_terceros">
            <field name="name">account.check.third.tree.depositos</field>
            <field name="model">account.check.third</field>
            <field name="arch" type="xml">
                <tree string="Cheques">
                    <field name="number" string="Numero" />
                    <field name="source_partner_id" />
                    <field name="bank_id" string="Banco" />
                    <field name="issue_date" string="Fecha de Emision"/>
                    <field name="payment_date" string="Fecha de Pago" />
                    <field name="amount" sum="Monto" string="Monto"/>
                    <field name="state" invisible="1"/>
                </tree>
            </field>
        </record>

        <record model="ir.ui.view" id="cheques_deposit_form_view">
            <field name="name">cheques.depo.form</field>
            <field name="model">depositos.cheques</field>
            <field name="arch" type="xml">
                <form string="Deposito de Cheques">
                    <header>
                        <button name="confirmar" type="object" string="Confirmar Deposito" invisible="state != 'borrador'"/>
                        <button name="anular" type="object" string="Anular" invisible="state != 'confirmado'"/>
                        <button name="pasar_borrador" type="object" string="Pasar a borrador" invisible="state != 'anulado'"/>
                        <field name="state" widget="statusbar"/>
                    </header>
                    <sheet readonly="state != 'borrador'">
                        <label for="name" class="oe_edit_only" />
                        <h1>
                            <field name="name" readonly="state != 'borrador'"/>
                        </h1>
                        <group>
                            <group>
                                <field name="tipo_deposito" readonly="state != 'borrador'" widget="radio"/>
                                <field name="fecha" readonly="state != 'borrador'"/>
                                <field name="cuenta" readonly="state != 'borrador'" domain="[('type','in',('bank','cash'))]" options="{'no_open': True, 'no_create_edit': True, 'no_create': True}"/>
                                <field name="moneda_extranjera" invisible="1"/>
                                <field name="currency_id" domain="[('ambito','in',('venta',False))]" readonly="state != 'borrador'" options="{'no_open': True, 'no_create_edit': True, 'no_create': True}"/>
                                <field name="fecha_cobro" readonly="state != 'borrador'" invisible="moneda_extranjera == False" required="moneda_extranjera == True and state == 'borrador'"/>
                                <label for="monto_a_depositar" invisible="tipo_deposito == 'manual'" readonly="state != 'borrador'"/>
                                <div name="amount_div" invisible="tipo_deposito == 'manual'" readonly="state != 'borrador'" class="o_row">
                                    <field name="monto_a_depositar" invisible="tipo_deposito == 'manual'" readonly="state != 'borrador'"/>
                                </div>
                                <label for="monto_manual" invisible="tipo_deposito != 'manual'" readonly="state != 'borrador'"/>
                                <div name="amount_div" class="o_row">
                                    <field name="monto_manual" invisible="tipo_deposito != 'manual'" readonly="state != 'borrador'"/>
                                </div>
                                <field name="forzar_origen" readonly="state != 'borrador'"/>
                                <field name="journal_from" invisible="tipo_deposito != 'manual'" required="tipo_deposito == 'manual'" readonly="state != 'borrador'"/>
                                <field name="journal_from" invisible="forzar_origen == False" required="forzar_origen == True" readonly="state != 'borrador'"/>
                                <field name="cuenta_from" invisible="forzar_origen == False"/>
                            </group>
                            <group>
                                <field name="asiento_contable" readonly="1"/>
                                <field name="company_id" string="Compañia" readonly="1" options="{'no_open': True, 'no_create_edit': True, 'no_create': True}"/>
                                <field name="obs"/>
                            </group>
                        </group>
                        <br/>
                        <notebook invisible="tipo_deposito == 'cheque'" readonly="state != 'borrador'">
                            <page string="Cobros Efectivo" invisible="journal_from != False">
                                <field name="depositos" invisible="tipo_deposito == 'cheque'" readonly="state != 'borrador'" context="{'default_boleta_deposito_id': active_id}" domain="[('boleta_deposito_id','=', False), ('journal_id.type','=', 'cash'), ('debit','!=',0)]" string="Efectivo a depositar" widget="many2many">
                                    <tree>
                                        <field name="date" readonly="1" string="Fecha"/>
                                        <field name="name" readonly="1" string="Descripcion"/>
                                        <field name="ref" readonly="1" string="Referencia"/>
                                        <field name="amount_currency" readonly="1" sum="montousd" string="Monto Mon. extr."/>
                                        <field name="debit" readonly="1" sum="Monto" string="Monto Ingreso"/>
                                        <field name="credit" readonly="1" sum="Monto" string="Monto Egreso"/>
                                        <field name="boleta_deposito_id" invisible="1"/>
                                    </tree>
                                </field>
                            </page>
                            <page string="Cobros Efectivo" invisible="journal_from == False">
                                <field name="depositos" invisible="tipo_deposito == 'cheque'" readonly="state != 'borrador'" context="{'default_boleta_deposito_id': active_id}" domain="[('boleta_deposito_id','=', False), ('journal_id.type','=', 'cash'), ('debit','!=',0), ('journal_id','=', journal_from)]" string="Efectivo a depositar" widget="many2many">
                                    <tree>
                                        <field name="date" readonly="1" string="Fecha"/>
                                        <field name="name" readonly="1" string="Descripcion"/>
                                        <field name="ref" readonly="1" string="Referencia"/>
                                        <field name="amount_currency" readonly="1" sum="montousd" string="Monto Mon. extr."/>
                                        <field name="debit" readonly="1" sum="Monto" string="Monto Ingreso"/>
                                        <field name="credit" readonly="1" sum="Monto" string="Monto Egreso"/>
                                        <field name="boleta_deposito_id" invisible="1"/>
                                    </tree>
                                </field>
                            </page>
                        </notebook>
                        <notebook invisible="tipo_deposito != 'cheque'" readonly="state != 'borrador'">
                            <page string="Cheques con filtro" invisible="forzar_origen == False">
                                <field name="cheques" domain="[('state','in',('handed','rechazado')),('cuenta_origen','=',cuenta_from)]" string="Cheques a depositar" widget="many2many">
                                    <tree context="{'tree_view_ref': 'account_deposit.vista_cheques_terceros'}">
                                        <field name="number" string="Numero"/>
                                        <field name="bank_id" string="Banco"/>
                                        <field name="source_partner_id"/>
                                        <field name="issue_date" string="Fecha de Emision"/>
                                        <field name="payment_date" string="Fecha de Pago"/>
                                        <field name="amount" sum="Monto" string="Monto"/>
                                        <field name="state" invisible="1"/>
                                    </tree>
                                </field>
                            </page>
                             <page string="Cheques" invisible="forzar_origen != False">
                                <field name="cheques" domain="[('state','in',('handed','rechazado'))]" string="Cheques a depositar" widget="many2many">
                                    <tree context="{'tree_view_ref': 'account_deposit.vista_cheques_terceros'}">
                                        <field name="number" string="Numero"/>
                                        <field name="bank_id" string="Banco"/>
                                        <field name="source_partner_id"/>
                                        <field name="issue_date" string="Fecha de Emision"/>
                                        <field name="payment_date" string="Fecha de Pago"/>
                                        <field name="amount" sum="Monto" string="Monto"/>
                                        <field name="state" invisible="1"/>
                                    </tree>
                                </field>

                            </page>

                        </notebook>
                    </sheet>
                    <div class="oe_chatter">
                        <field name="message_follower_ids" widget="mail_followers"/>
                        <field name="message_ids" widget="mail_thread"/>
                    </div>
                </form>
            </field>
        </record>
        <record model="ir.ui.view" id="deposito_bol_tree_view">
            <field name="name">deposito.bol.tree</field>
            <field name="model">depositos.cheques</field>
            <field name="arch" type="xml">
                <tree>
                    <field name="fecha"/>
                    <field name="tipo_deposito"/>
                    <field name="cuenta"/>
                    <field name="currency_id"/>
                    <field name="monto_manual"/>
                    <field name="journal_from" optional="hide"/>
                    <field name="obs"/>
                </tree>
            </field>
        </record>

        <record model="ir.ui.view" id="deposito_bol_search_view">
            <field name="name">deposito.bol.search</field>
            <field name="model">depositos.cheques</field>
            <field name="arch" type="xml">
                <search>
                    <field name="name"/>
                    <field name="fecha"/>
                    <field name="cuenta"/>
                </search>
            </field>
        </record>

        <record model="ir.actions.act_window" id="action_depositos_cheques">
            <field name="name">Depositos</field>
            <field name="type">ir.actions.act_window</field>
            <field name="res_model">depositos.cheques</field>
            <field name="view_mode">tree,form</field>
            <field name="help" type="html">
                <p class="oe_view_nocontent_create">Crear Boleta Deposito</p>
            </field>
        </record>

        <menuitem action="action_depositos_cheques" id="menu_action_depositos_cheques" parent="account_check.menu_tesoreria"/>
    </data>
</odoo>

