<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <data>
        <template id="report_deposito_view">
            <t t-call="web.html_container">
                <t t-foreach="docs" t-as="o">
                    <t t-call="web.internal_layout">
                        <div class="header">
                            <div class="col-6">
                                <h3>
                                    <span t-field="res_company.name"/>
                                </h3>
                            </div>
                            <!--Fecha y paginacion de hoja-->
                            <div class="col-4 pull-right fecha">
                                <p>Fecha:
                                    <span t-esc="context_timestamp(datetime.datetime.now()).strftime('%d/%m/%Y %H:%M')"/>
                                </p>
                                <span>Pag:</span>
                                <span class="page"/>
                                de
                                <span class="topage"/>
                            </div>
                        </div>
                        <div class="row">
                            <div class="col-12">
                                <h4>BOLETA DE DEPOSITO NRO
                                    <span t-field="o.name"/>
                                </h4>
                            </div>
                        </div>

                        <link rel="stylesheet" href="/account_deposit/static/src/css/deposito.css"/>
                        <div class="page">
                            <div class="row ">
                                <div class="col-6">
                                    <p>Fecha:
                                        <span t-field="o.fecha"/>
                                    </p>
                                    <p>Moneda:
                                        <span t-field="o.currency_id.name"/>
                                    </p>
<!--                                    <p>Monto:-->
<!--                                        <span t-field="o.monto_a_depositar"/>-->
<!--                                    </p>-->
                                    <p>Monto:
                                        <span t-field="o.monto_manual"/>
                                    </p>
                                </div>

                                <div class="col-6">
                                    <p>Cuenta a Depositar:
                                        <span t-field="o.cuenta.name"/>
                                    </p>
                                    <p>Tipo de deposito:
                                        <span t-field="o.tipo_deposito"/>
                                    </p>
                                    <p>Obs.:
                                        <span t-field="o.obs"/>
                                    </p>
                                </div>
                            </div>
                            <t t-if="o.tipo_deposito == 'cheque'">
                                <br/>
                                <br/>

                                <h5>Datos del Cheque</h5>
                                <table class=" sin-borde">
                                    <thead>
                                        <tr class="active">
                                            <th>Numero</th>
                                            <th>Banco</th>
                                            <th>Empresa</th>
                                            <th>Fecha Emision</th>
                                            <th>Fecha Pago</th>
                                            <th>Monto</th>

                                        </tr>
                                    </thead>

                                    <tbody>
                                        <t t-foreach="o.cheques" t-as="cheque">
                                            <tr>
                                                <td>
                                                    <span t-field="cheque.number"/>
                                                </td>
                                                <td>
                                                    <span t-field="cheque.bank_id.name"/>
                                                </td>
                                                <t t-if="cheque.owner_name">
                                                    <td>
                                                        <span t-field="cheque.owner_name"/>
                                                    </td>
                                                </t>
                                                <t t-elif="cheque.source_partner_id">
                                                    <td>
                                                        <span t-field="cheque.source_partner_id.name"/>
                                                    </td>
                                                </t>
                                                <t t-else="">
                                                    <td></td>
                                                </t>
                                                <td>
                                                    <span t-field="cheque.issue_date"/>
                                                </td>
                                                <td>
                                                    <span t-field="cheque.payment_date"/>
                                                </td>
                                                <td>
                                                    <span t-esc="o.agregar_punto_de_miles(cheque.amount)"/>
                                                </td>

                                            </tr>
                                        </t>
                                    </tbody>
                                </table>
                            </t>
                            <t t-if="o.depositos">
                                <br/>
                                <br/>
                                <table class=" sin-borde-2">
                                    <thead>
                                        <tr class="active">
                                            <th>Fecha</th>
                                            <th>Referencia</th>
                                            <th>Empresa</th>
                                            <th>Monto</th>
                                        </tr>
                                    </thead>

                                    <tbody>
                                        <t t-foreach="o.depositos" t-as="d">
                                            <tr>
                                                <td>
                                                    <span t-field="d.date"/>
                                                </td>
                                                <td>
                                                    <span t-field="d.ref"/>
                                                </td>
                                                <td>
                                                    <span t-field="d.partner_id.name"/>
                                                </td>
                                                <td>
                                                    <span t-esc="o.agregar_punto_de_miles(abs(d.debit))"/>
                                                </td>
                                            </tr>
                                        </t>
                                    </tbody>
                                </table>
                            </t>
                        </div>

                    </t>
                </t>
            </t>
        </template>
    </data>
</odoo>