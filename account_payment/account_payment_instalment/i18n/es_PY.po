#, python-format
msgid "A Payment Term of type Instalment should have number of instalments more than 0."
msgstr "Una plazo de pago de tipo Cuotas debe tener como minimo 1 cuota."

#. module: account_payment_instalment
#: code:addons/account_payment_instalment/models/account_payment_term.py:56
#, python-format
msgid "A Payment Term should have its last line of type Balance/Instalment."
