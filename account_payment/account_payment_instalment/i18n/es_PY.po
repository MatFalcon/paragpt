#. module: account_payment_instalment
#: code:addons/account_payment_instalment/models/account_payment_term.py:61
#, python-format
msgid "A Payment Term should have only one line of type Balance."
msgstr "Un  plazo de pago solo debe tener una linea de tipo Saldo."

#. module: account_payment_instalment
#: code:addons/account_payment_instalment/models/account_payment_term.py:66
#, python-format
msgid "A Payment Term should have only one line of type Instalment."
msgstr "Un  plazo de pago solo debe tener una linea de tipo Cuota."

#. module: account_payment_instalment
#: code:addons/account_payment_instalment/models/account_payment_term.py:72
#, python-format
msgid "A Payment Term should have only one of type Balance and Instalment."
msgstr "Un  plazo de pago solo debe tener una linea de tipo Saldo y Cuota."

