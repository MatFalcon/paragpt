<odoo>
    <data>
            <record id="pbp_novedades_series_tree" model="ir.ui.view">
              <field name="name">pbp.novedades_series.tree</field>
              <field name="model">pbp.novedades_series</field>
              <field name="arch" type="xml">
                <tree string="Channel">
                  <field name="id" />
                  <field name="id_operacion" />
                  <field name="partner_id" />
                  <field name="product_id" />
                  <field name="fecha" />
                  <field name="currency_id" />
                  <field name="state" />
                  <field name="valor_nominal" />
                  <field name="cantidad" />
                  <field name="volumen"  sum="Total"/>
                  <field name="total_arancel" sum="Total"/>
                  <field name="total" sum="Total"/>
                </tree>
              </field>
            </record>

            <record id="pbp_novedades_series_dialog_tree" model="ir.ui.view">
              <field name="name">pbp.novedades_series.dialog.tree</field>
              <field name="model">pbp.novedades_series</field>
              <field name="arch" type="xml">
                <tree string="Channel">
                  <field name="id" />
                  <field name="id_operacion" />
                  <field name="tipo_contrato_descripcion" />
                  <field name="partner_id" />
                  <field name="product_id" />
                  <field name="fecha" />
                  <field name="currency_id" />
                  <field name="state" invisible="1" />
                  <field name="total" />
                </tree>
              </field>
            </record>

         <record id="view_pbp_novedades_series_search" model="ir.ui.view">
          <field name="name">pbp.novedades_series.search</field>
          <field name="model">pbp.novedades_series</field>
          <field name="arch" type="xml">
            <search string="Buscar Novedades Series">
              <field name="id_operacion"/>
              <field name="fecha"/>
              <field name="tipo_contrato_descripcion"/>
              <field name="state"/>
              <field name="partner_id"/>
              <field name="product_id"/>
              <field name="currency_id"/>
              <group string="Filtros Predeterminados">
                <filter name="state_pendiente" string="Pendiente" domain="[('state', '=', 'pendiente')]"/>
                <filter name="state_publicado" string="Publicado" domain="[('state', '=', 'publicado')]"/>
                <filter name="tipo_compra" string="Compras" domain="[('tipo', '=', 'compra')]"/>
                <filter name="tipo_venta" string="Ventas" domain="[('tipo', '=', 'venta')]"/>
              </group>
              <group string="Agrupaciones">
                <filter name="group_by_fecha" string="Fecha" context="{'group_by': 'fecha'}"/>
                <filter name="group_by_cliente" string="Cliente" context="{'group_by': 'partner_id'}"/>
                <filter name="group_by_tipo" string="Tipo de Operación" context="{'group_by': 'tipo'}"/>
              </group>
            </search>
          </field>
        </record>

          <record id="view_pbp_novedades_series_form" model="ir.ui.view">
            <field name="name">pbp.novedades_series.form</field>
            <field name="model">pbp.novedades_series</field>
            <field name="arch" type="xml">
              <form string="Novedades Series">
                <sheet>
                  <group string="Información General">
                    <group string="Detalles de la Operación">
                      <field name="id_operacion"/>
                      <field name="tipo_contrato_descripcion"/>
                      <field name="fecha"/>
                      <field name="state"/>
                    </group>
                    <group string="Detalles Financieros">
                      <field name="valor_nominal"/>
                      <field name="cantidad"/>
                      <field name="volumen"/>
                      <field name="total_arancel"/>
                      <field name="iva"/>
                      <field name="total"/>
                    </group>
                  </group>
                  <group string="Relaciones">
                    <group string="Datos del Cliente">
                      <field name="partner_id"/>
                      <field name="persona_id"/>
                    </group>
                    <group string="Datos del Producto">
                      <field name="product_id"/>
                      <field name="currency_id"/>
                      <field name="invoice_id"/>
                    </group>
                  </group>
                </sheet>
              </form>
            </field>
          </record>

           <record id="novedades_series_action" model="ir.actions.act_window">
              <field name="name">Sistema Tradicional</field>
              <field name="res_model">pbp.novedades_series</field>
              <field name="view_mode">tree,form</field>
              <field name="context">{'edit': 0, 'tree_view_ref': 'pbp.pbp_novedades_series_tree'}</field>
            </record>

    </data>
</odoo>