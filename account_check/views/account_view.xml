<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <record id="view_account_check_journal_form" model="ir.ui.view">
            <field name="name">account_check.account.journal.form</field>
            <field name="model">account.journal</field>
            <field name="inherit_id" ref="account.view_account_journal_form"/>
            <field name="arch" type="xml">
                <data>
                    <xpath expr="//form/sheet/notebook" position="inside">
                        <page string="Chequeras" invisible="payment_subtype != 'issue_check'">
                            <field name="checkbook_ids" required="payment_subtype == 'issue_check'" context="{'default_company_id': company_id, 'default_debit_journal_id': active_id}"/>
                        </page>
                    </xpath>

                </data>
            </field>
        </record>

        <record id="inherit_purchase_voucher_form_check_id" model="ir.ui.view">
            <field name="name">account.voucher.purchase.form.inherit.check_id</field>
            <field name="model">account.voucher</field>
            <field name="inherit_id" ref="account_voucher.view_purchase_receipt_form"/> 
            <field name="arch" type="xml">
                <xpath expr="//field[@name='payment_journal_id']" position="after">
                    <field name="diario_tipo_cheque" invisible="1"/>
                    <field name="check_id" context="{'default_type':'issue_check','default_amount':amount,'default_pago_voucher':[active_id]}"
                        invisible="diario_tipo_cheque != 'issue_check'"
                        readonly="state != 'draft'"/>
                </xpath>
            </field>
        </record>
        
    </data>
</odoo>
