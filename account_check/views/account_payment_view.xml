<odoo>
    <data>

        <!-- Vista de formulario heredada para pagos con cheques a proveedores -->
        <record id="view_vendor_payment_check_form" model="ir.ui.view">
            <field name="name">account.payment.check.form.inherit</field>
            <field name="model">account.payment</field>
            <field name="inherit_id" ref="account.view_account_payment_form"/>
            <field name="arch" type="xml">
                <xpath expr="//field[@name='ref']" position="after">
                    <h3 style="color:#5882FA" invisible="payment_subtype != 'issue_check'">Datos del cheque </h3>
                    <hr/>
                    <field name="checks_amount" widget="monetary" options="{'currency_field': 'currency_id'}" invisible="payment_subtype == False"/>
                    <field name="payment_subtype" invisible="1"/>
                </xpath>
                <xpath expr="//form/sheet/group" position="after">
                    <notebook invisible="payment_subtype != 'third_check' or payment_type != 'inbound'">
                        <field name="payment_subtype" invisible="1"/>
                        <page string="Cheques terceros">
                            <field name="received_third_check_ids" context="{'default_date':date,'default_amount':amount,'default_currency_id':currency_id}" groups="base.group_multi_currency"/>
                        </page>
                    </notebook>
                    <notebook invisible="payment_subtype != 'issue_check' or payment_type != 'outbound'">
                        <field name="payment_subtype" invisible="1"/>
                        <page string="Cheques propios">
                            <field name="issued_check_ids" context="{'default_type':'issue_check','from_voucher':True,'default_journal_id':journal_id,'default_issue_date':date,'default_amount': amount}"/>
                        </page>
                    </notebook>
                </xpath>
            </field>
        </record>

        <!-- Vista de formulario heredada para registro de pagos con cheques -->
        <record model="ir.ui.view" id="cobros_form_view_inh_register">
            <field name="name">account.payment.register.cheque.inh</field>
            <field name="model">account.payment.register</field>
            <field name="type">form</field>
            <field name="inherit_id" ref="account.view_account_payment_register_form"/>
            <field name="arch" type="xml">
                <form>
                    <group>
                        <field name="cheque_tercero" invisible="0"/>
                    </group>
                    <group string="Datos del Cheque" invisible="cheque_tercero != True" required="cheque_tercero == True">
                        <field name="banco_cheque_recibo" invisible="cheque_tercero != True" required="cheque_tercero == True" string="Banco del Cheque" widget="selection"/>
                        <field name="titular_recibo" invisible="cheque_tercero != True" required="cheque_tercero == True" string="Titular"/>
                        <field name="nro_cuenta_recibo" invisible="cheque_tercero != True" required="cheque_tercero == True"/>
                        <field name="numero_cheque_recibo" invisible="cheque_tercero != True" required="cheque_tercero == True" string="Numero del Cheque"/>
                        <field name="fecha_cheque_recibo" invisible="cheque_tercero != True" required="cheque_tercero == True" string="Fecha Emision"/>
                        <field name="fecha_cheque_diferido" invisible="cheque_tercero != True" required="cheque_tercero == True" string="Fecha Pago Cheque"/>
                    </group>
                </form>
            </field>
        </record>

    </data>
</odoo>

