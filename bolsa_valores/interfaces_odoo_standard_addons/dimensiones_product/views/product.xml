<?xml version='1.0' encoding='utf-8'?>
<odoo>
    <data >
        <!-- model.name inherit form view -->
        <record id="product_template_only_form_view" model="ir.ui.view">
            <field name="name">product_template_only_form_view</field>
            <field name="model">product.template</field>
            <field name="inherit_id" ref="product.product_template_only_form_view"/>
            <field name="arch" type="xml">
                <xpath expr="//group[@name='group_lots_and_weight']/field[@name='responsible_id']" position="before">
                    <label for="ancho"/>
                    <div class="o_row" name="ancho" attrs="{'invisible':[('product_variant_count', '&gt;', 1), ('is_product_variant', '=', False)]}">
                        <field name="ancho"/>
                        <span>cm</span>
                    </div>
                    <label for="largo"/>
                    <div class="o_row" name="largo" attrs="{'invisible':[('product_variant_count', '&gt;', 1), ('is_product_variant', '=', False)]}">
                        <field name="largo"/>
                        <span>cm</span>
                    </div>
                    <label for="alto"/>
                   <div class="o_row" name="alto" attrs="{'invisible':[('product_variant_count', '&gt;', 1), ('is_product_variant', '=', False)]}">
                        <field name="alto"/>
                        <span>cm</span>
                    </div>
                </xpath>

            </field>
        </record>

    </data>
</odoo>