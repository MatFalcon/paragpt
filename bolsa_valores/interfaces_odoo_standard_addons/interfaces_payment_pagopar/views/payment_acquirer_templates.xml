<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <template id="redirect_form">
            <form t-att-action="api_url" method="post">
                <input type="hidden" name="csrf_token" t-att-value="request.csrf_token()"/>
                <input type="hidden" name="token" t-att-value="token"/>
                <input type="hidden" name="comprador" t-att-value="comprador"/>
                <input type="hidden" name="public_key" t-att-value="public_key"/>
                <input type="hidden" name="monto_total" t-att-value="monto_total"/>
                <input type="hidden" name="tipo_pedido" t-att-value="monto_total"/>
                <input type="hidden" name="compras_items" t-att-value="compras_items"/>
                <input type="hidden" name="fecha_maxima_pago" t-att-value="fecha_maxima_pago"/>
                <input type="hidden" name="id_pedido_comercio" t-att-value="id_pedido_comercio"/>
                <input type="hidden" name="descripcion_resumen" t-att-value="descripcion_resumen"/>
                <input type="hidden" name="costo_envio" t-att-value="costo_envio"/>
                <input type="hidden" name="envio_seleccionado" t-att-value="envio_seleccionado"/>
            </form>
        </template>

        <template id="interfaces_payment_pagopar.error_pago">
            <t t-call="website.layout">
                <t t-set="title">Error en Pago</t>
                <div id="wrap">
                    <div class="container oe_website_sale py-2">
                        <h1><span>Pedido</span> <em t-field="order.name" />
                            <t t-if="order.state == 'sale'"><span>Confirmado</span></t>
                        </h1>
                        <div class="row">
                            <div class="col-12 col-xl">
                                <div class="oe_cart">
                                    <div class="thanks_msg">
                                        <h2>
                                            <span t-esc="resultado"/><br/>
                                            No hemos podido procesar su pago. Por favor pongase en contacto con nosotros.
                                        </h2>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </t>
        </template>
    </data>
</odoo>
    