<?xml version='1.0' encoding='utf-8'?>
<odoo>
    <data>
        <record id="view_move_form" model="ir.ui.view">
            <field name="name">view_move_form</field>
            <field name="model">account.move</field>
            <field name="inherit_id" ref="account.view_move_form"/>
            <field name="arch" type="xml">
                <xpath expr="//group[@id='header_right_group']" position="inside">
                    <field name="factura_web_ecommerce" attrs="{'invisible': ['|', ('state', '!=', 'draft'), ('move_type', '!=', 'in_invoice')]}"/>
                    <label for='reversado' string='Reversado'/>
                    <div class="d-flex" attrs="{'invisible': [('move_type', 'not in', ('out_invoice')),('factura_web_ecommerce','=',False)]}">
                        <field name="reversado" readonly="1"/>
                    </div>
                    <label for='tiempo_reversion' string='Tiempo de Reversion'/>
                    <div class="d-flex" attrs="{'invisible': [('move_type', 'not in', ('out_invoice')),('reversado','=',False)]}">
                        <field name="tiempo_reversion" readonly="1"/>
                    </div>
                </xpath>
                <xpath expr="//header" position="inside">
                    <button string="Reversar pago" type="object" name="button_reversar"
                            attrs="{'invisible':[('payment_state', '!=', 'paid'),('factura_web_ecommerce','=',False),('reversado','=',True)]}"/>
                </xpath>

            </field>
        </record>
    </data>
</odoo>