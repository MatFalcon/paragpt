<odoo>
    <data>
        <record id="interfaces_pagopar_address" model="ir.ui.view">
            <field name="name">interfaces_pagopar_address</field>
            <field name="inherit_id" ref="website_sale.address"/>
            <field name="arch" type="xml">
                <xpath expr="//input[@name='city']" position="replace">
                    <select id="city_id" name="city_id" t-attf-class="form-control #{error.get('city_id') and 'is-invalid' or ''}">
                        <option value="">Ciudad...</option>
                        <t t-foreach="cities" t-as="c">
                            <option t-att-value="c.id" t-att-selected="c.id == (city and city.id or -1)">
                                <t t-esc="c.name"/>
                            </option>
                        </t>
                    </select>
                    <!--div class="form-group #{error.get('vat') and 'has-error' or ''} col-md-6">
                        <label class="control-label" for="vat">C.I. o RUC</label>
                        <input type="text" name="vat" class="form-control"/>
                    </div-->
                </xpath>
            </field>
        </record>

        <record id="interfaces_pagopar_address_kanban" model="ir.ui.view">
            <field name="name">interfaces_pagopar_address_kanban</field>
            <field name="inherit_id" ref="website_sale.address_kanban"/>
            <field name="arch" type="xml">
                <xpath expr="//t[@t-esc='contact']" position="replace">
                    <div>
                        <t t-esc="contact.name"/>
                    </div>
                    <div>
                        <t t-esc="contact.street"/>
                    </div>
                    <div>
                        <t t-esc="contact.city_id.name"/>
                    </div>
                    <div>
                        <t t-esc="contact.country_id.name"/>
                    </div>
                </xpath>
            </field>
        </record>

        <record id="interfaces_pagopar_payment_tokens_list" model="ir.ui.view">
            <field name="name">interfaces_pagopar_payment_tokens_list</field>
            <field name="inherit_id" ref="payment.checkout"/>
            <field name="arch" type="xml">

                <xpath expr='//span[@class="payment_option_name"]' position="after">
                    <t t-if="not acquirer.envio_flete">
                        <span style="font-style:italic; text-align:center; color:gray;">sin costo de envio</span>
                    </t>
                    <t t-else="">
                        <span style="font-style:italic; text-align:center; color:gray;">
                            +
                            <span t-field="website_sale_order.flete_total"/>
                            costo de envio
                        </span>
                    </t>
                </xpath>

            </field>
        </record>
    </data>
</odoo>