<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <data noupdate="1">
    
        <record id="control_acceso.activado" model="ir.config_parameter">
            <field name="key">control_acceso_activado</field>
            <field name="value">0</field>
        </record>
        <record id="control_acceso.ips_admitidas" model="ir.config_parameter">
            <field name="key">control_acceso_ips_admitidas</field>
            <field name="value">*</field>
        </record>
        <record id="control_acceso.hora_inicio" model="ir.config_parameter">
            <field name="key">control_acceso_hora_inicio</field>
            <field name="value">6:00</field>
        </record>
        <record id="control_acceso.hora_fin" model="ir.config_parameter">
            <field name="key">control_acceso_hora_fin</field>
            <field name="value">19:00</field>
        </record>
        <record id="control_acceso.dia" model="ir.config_parameter">
            <field name="key">control_acceso_dia</field>
            <field name="value">1,2,3,4,5,6,7</field>
        </record>
        <record id="control_acceso.grupo_acceso" model="res.groups">
            <field name="name">Sin restricción de acceso</field>
        </record>
    
    </data>
    

</odoo>
