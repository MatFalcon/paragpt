<odoo>
    <data>
        <record model="helpdesk.stage" id="nuevo1">
            <field name="name">Nuevo derivado</field>
        </record>
        <record model="helpdesk.stage" id="en_proceso2">
            <field name="name">En proceso</field>
        </record>
        <record model="helpdesk.stage" id="resuelto3">
            <field name="name">Resuelto</field>
        </record>


        <record id="helpdesk_dias" model="ir.cron">
            <field name="name">Dias de un ticket</field>
            <field eval="True" name="active" />
            <field name="user_id" ref="base.user_root" />
            <field name="interval_number">1</field>
            <field name="interval_type">days</field>
            <field name="numbercall">-1</field>
            <field ref="helpdesk.model_helpdesk_ticket" name="model_id"/>
            <field name="state">code</field>
            <field name="code">
tickets = env['helpdesk.ticket'].search([])
tickets.calcular_dias()
            </field>
            <field eval="False" name="doall"/>
        </record>

    </data>
</odoo>