<odoo>
    <data>
        <template id="interfaces_payment.reporte_orden_pago">
            <t t-call="web.html_container">
                <t t-call="web.external_layout">
                    <style>
                        p, b, span, strong{
                        font-size:14px;
                        }
                        .borde1 {
                        border:1px solid black;
                        }
                        .col-1 {
                        margin:0px;
                        }
                        .col-2 {
                        margin:0px;
                        }
                        .col-3 {
                        margin:0px;
                        }
                    </style>
                    <div class="page">
                        <div>
                            <div style="text-align:center;font-size:2em;">
                                <div style="width:50%;float:left;">
                                    Orden de Pago
                                </div>
                                <div style="width:50%;float:right;">
                                    <t t-esc="', '.join(recibo_name)"/>
                                </div>
                            </div>
                            <div class="row">
                                <div class="col-3">
                                    <strong>Proveedor:</strong>
                                    <span t-esc="partner.name"/>
                                    <br/>
                                    <strong>Moneda:</strong>
                                    <span t-esc="moneda.name"/>
                                </div>
                                <div class="col-3">
                                    <strong>Diario:</strong>
                                    <span t-esc="diario.name"/>
                                    <br/>
                                    <strong>Fecha:</strong>
                                    <span t-esc="fecha"/>
                                </div>
                            </div>
                        </div>
                        <div id="partials_list_header" class="row borde1">
                            <div class="col-2">
                                <p>Fecha</p>
                            </div>
                            <div class="col-3">
                                <p>Referencia</p>
                            </div>
                            <div class="col-2">
                                <p>Nro Doc.</p>
                            </div>
                            <div class="col-2">
                                <p>Concepto</p>
                            </div>
                            <div class="col-2">
                                <p>Monto</p>
                            </div>
                        </div>
                        <t t-set="total_pays" t-value="0"/>
                        <t t-set="total_partials" t-value="0"/>
                        <div id="partials_list">
                            <t t-foreach="payments" t-as="payment">
                                <t t-foreach="payment.move_id._get_reconciled_invoices_partials()"
                                   t-as="rec">
                                    <t t-set="amount" t-value="rec[1]"/>
                                    <t t-set="factura" t-value="rec[2].move_id"/>
                                    <t t-if="factura.move_type != 'entry'">
                                        <div class="row">
                                            <div class="col-2">
                                                <p>
                                                    <span t-esc="factura.invoice_date"/>
                                                </p>
                                            </div>
                                            <div class="col-3">
                                                <p>
                                                    <span t-esc="factura.partner_id.name"/>
                                                </p>
                                            </div>
                                            <div class="col-2">
                                                <p>
                                                    <span t-esc="factura.ref"/>
                                                </p>
                                            </div>
                                            <div class="col-2">
                                                <p>
                                                    <span t-esc="factura.payment_reference"/>
                                                </p>
                                            </div>
                                            <div
                                                    class="col-2">
                                                <p>
                                                    <!-- <span t-esc="factura.amount_total" -->
                                                    <t t-set="total_partials"
                                                       t-value="total_partials + amount"/>
                                                    <span t-esc="amount"
                                                          t-options="{'widget': 'monetary',  'display_currency': factura.currency_id}"/>
                                                </p>
                                            </div>
                                        </div>
                                    </t>
                                </t>
                            </t>
                        </div>
                        <br/>
                        <div id="partials_total">
                            <div class="row">
                                <div
                                        class="col-9">
                                </div>
                                <div
                                        class="col-3">
                                    <p>
                                        <t t-esc="total_partials"
                                           t-options="{'widget': 'monetary', 'display_currency': moneda}"/>
                                    </p>
                                </div>
                            </div>
                        </div>
                        <br/>
                        <div id="payments_header">
                            <div class="row borde1">
                                <div class="col-2">
                                    <p>
                                        Fec Emision
                                    </p>
                                </div>
                                <div class="col-2">
                                    <p>
                                        Fec Venc
                                    </p>
                                </div>
                                <div class="col-2">
                                    <p>
                                        Nro Cheque
                                    </p>
                                </div>
                                <div class="col-2">
                                    <p>
                                        Banco
                                    </p>
                                </div>
                                <div class="col-2">
                                    <p>
                                        Conecpto
                                    </p>
                                </div>
                                <div class="col-2">
                                    <p>
                                        Monto
                                    </p>
                                </div>
                            </div>
                        </div>
                        <div id="payments_list">
                            <t t-foreach="payments" t-as="p">
                                <t t-set="total_pays"
                                   t-value="total_pays + p.amount"/>
                                <div class="row">
                                    <div class="col-2">
                                        <p>
                                            <t t-esc="p.fecha_cheque"/>
                                        </p>
                                    </div>
                                    <div class="col-2">
                                        <p>
                                            <t t-esc="p.fecha_vencimiento_cheque"/>
                                        </p>
                                    </div>
                                    <div class="col-2">
                                        <p>
                                            <t t-esc="p.nro_cheque"/>
                                        </p>
                                    </div>
                                    <div class="col-2">
                                        <p>
                                            <t t-esc="p.bank_id.name"/>
                                        </p>
                                    </div>
                                    <div class="col-2">
                                        <p>
                                            <t t-esc="p.ref"/>
                                        </p>
                                    </div>
                                    <div class="col-2">
                                        <p>
                                            <t t-esc="p.amount"
                                               t-options="{'widget': 'monetary', 'display_currency': p.currency_id}"/>
                                        </p>
                                    </div>
                                </div>
                            </t>
                        </div>
                        <br/>
                        <div id="footer_1">
                            <p>Recibimos el/los cheque/s moencionado/s por
                                <t
                                        t-esc="total_pays"
                                        t-options="{'widget': 'monetary', 'display_currency': moneda}"/>
                            </p>
                        </div>
                        <br/>
                        <div id="footer_2">
                            <div class="row">
                                <div class="col-4">
                                    <p>
                                        Confeccionado por:
                                    </p>
                                </div>
                                <div class="col-4">
                                    <p>
                                        Verificado por:
                                    </p>
                                </div>
                                <div class="col-4">
                                    <p>
                                        Autorizado por:
                                    </p>
                                </div>
                            </div>
                        </div>
                        <br/>
                        <div id="footer_3">
                            <p style="text-align:right">
                                <t t-esc="company.city"/>,________de______________________________del
                                20________
                            </p>
                        </div>
                        <br/>
                        <div id="footer_4">
                            <div class="row">
                                <div class="col-12">
                                    <p style="text-align:center">
                                        Proveedor
                                    </p>
                                </div>
                            </div>
                        </div>
                        <br/>
                        <div id="footer_5">
                            <div class="row">
                                <div class="col-4">
                                    <p>
                                        Confeccionado por:
                                    </p>
                                </div>
                                <div class="col-4">
                                    <p>
                                        Verificado por:
                                    </p>
                                </div>
                                <div class="col-4">
                                    <p>
                                        Autorizado por:
                                    </p>
                                </div>
                            </div>
                        </div>
                    </div>
                </t>
            </t>
        </template>

        <record model="ir.actions.report" id="interfaces_payment.reporte_orden_pago_action">
            <field name="name">Orden de pago</field>
            <field name="model">account.payment</field>
            <field name="report_type">qweb-pdf</field>
            <field name="report_name">interfaces_payment.reporte_orden_pago</field>
            <field name="paperformat_id" ref="base.paperformat_us"/>
            <field name="binding_model_id" ref="account.model_account_payment"/>
            <field name="binding_type">report</field>
        </record>
    </data>
</odoo>