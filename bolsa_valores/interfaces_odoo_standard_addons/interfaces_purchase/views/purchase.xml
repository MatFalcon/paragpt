<odoo>
    <data>
        <record model="ir.ui.view" id="purchase_order_form_costeo_inherit">
            <field name="name">purchase.order.form.costeo.inherit</field>
            <field name="model">purchase.order</field>
            <field name="inherit_id" ref="purchase.purchase_order_form" />
            <field name="arch" type="xml">
                <xpath
                    expr="//page[@name='purchase_delivery_invoice']/group/group[@name='invoice_info']"
                    position="inside">
                    <field name="nro_despacho" />
                </xpath>
            </field>
        </record>
    </data>
</odoo>
