<?xml version="1.0" encoding="UTF-8"?>
<odoo>

    <record model="ir.actions.act_window" id="calificacion_riesgo_action_view">
        <field name="name">Calificación de Riesgos
        </field>
        <field name="res_model">bvpasa_ingresos_diferidos.instrumento</field>
        <field name="view_mode">tree</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
            </p>
        </field>
    </record>


    <record model="ir.ui.view" id="calificacion_riesgo_tree_view">
        <field name="name">calificacion_riesgo_tree_view</field>
        <field name="model">bvpasa_ingresos_diferidos.calificacion_riesgo</field>
        <field name="arch" type="xml">
            <tree string="Calificación de Riesgos" create="1" editable="top">
                <field name="name"/>
                <field name="active"/>
            </tree>

        </field>
    </record>

    <record model="ir.ui.view" id="calificacion_riesgo_search_view">
        <field name="name">calificacion_riesgo_search_view</field>
        <field name="model">bvpasa_ingresos_diferidos.instrumento</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <field name="active"/>
            </search>
        </field>
    </record>

    <menuitem id="bvpasa_integracion_bancard.menu_calificacion_riesgo" name="Calificación de Riesgos" sequence="2" parent="account.account_management_menu"
              action="calificacion_riesgo_action_view"/>

</odoo>
