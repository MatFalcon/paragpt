<?xml version="1.0" encoding="UTF-8"?>
<odoo>

    <record model="ir.actions.act_window" id="instrumentos_action_view">
        <field name="name">Instrumentos
        </field>
        <field name="res_model">bvpasa_ingresos_diferidos.instrumento</field>
        <field name="view_mode">tree</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
            </p>
        </field>
    </record>


    <record model="ir.ui.view" id="instrumentos_tree_view">
        <field name="name">instrumentos_tree_view</field>
        <field name="model">bvpasa_ingresos_diferidos.instrumento</field>
        <field name="arch" type="xml">
            <tree string="Instrumentos" create="1" editable="top">
                <field name="name"/>
                <field name="active"/>
            </tree>

        </field>
    </record>

    <record model="ir.ui.view" id="instrumentos_search_view">
        <field name="name">instrumentos_search_view</field>
        <field name="model">bvpasa_ingresos_diferidos.instrumento</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <field name="active"/>
            </search>
        </field>
    </record>

    <menuitem id="bvpasa_integracion_bancard.menu_instrumentos" name="Instrumentos" sequence="2" parent="account.account_management_menu"
              action="instrumentos_action_view"/>

</odoo>
