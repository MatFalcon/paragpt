<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <record id="view_account_asset_form" model="ir.ui.view">
            <field name="name">view_account_asset_form</field>
            <field name="model">account.asset</field>
            <field name="inherit_id" ref="account_asset.view_account_asset_revenue_form"/>
            <field name="arch" type="xml">
                <xpath expr="//div[@name='button_box']" position="inside">
                    <button class="oe_stat_button" name="open_fa_entries" type="object" icon="fa-bars">
                            <field string="Entradas FA" name="fa_entries_count" widget="statinfo"/>
                        </button>
                </xpath>
                <!--xpath expr="//field[@name='depreciation_move_ids']" position="replace">

                </xpath-->
                <xpath expr="//field[@name='account_depreciation_id']" position="before">
                    <field name="flujo_alternativo" attrs="{'invisible': [('asset_type', '=', 'purchase')]}"/>
                </xpath>
                <xpath expr="//field[@name='account_depreciation_expense_id']" position="before">
                    <field name="account_depreciation_expense_cp_id" attrs="{'invisible': [('flujo_alternativo', '=', False)]}"/>
                    <field name="account_depreciation_expense_lp_id" attrs="{'invisible': [('flujo_alternativo', '=', False)]}"/>
                </xpath>
                <xpath expr="//field[@name='first_depreciation_date_import']/.." position="after">
                    <group string="Capital" attrs="{'invisible': [('asset_type', '=', 'purchase')]}">
                        <field name="monto_capital" attrs="{'invisible': [('asset_type', '=', 'purchase')]}"/>
                        <field name="account_capital_id" attrs="{'invisible': [('asset_type', '=', 'purchase')]}"/>
                        <field name="account_inversion_lp_id" attrs="{'invisible': [('asset_type', '=', 'purchase')]}"/>
                        <field name="account_inversion_cp_id" attrs="{'invisible': [('asset_type', '=', 'purchase')]}"/>
                        <field name="account_ingreso_capital" attrs="{'invisible': [('asset_type', '=', 'purchase')]}"/>
                    </group>
                </xpath>
            </field>
        </record>
    </data>
</odoo>