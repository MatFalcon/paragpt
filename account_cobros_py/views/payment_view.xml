<odoo>
    <data>
        <!-- Se agrega el recibo relacionado en cada registro de payment -->
         <record id="view_account_payment_form_recibo_inh" model="ir.ui.view">
            <field name="name">view.payment.inh</field>
            <field name="model">account.payment</field>
            <field name="type">form</field>
            <field name="inherit_id" ref="account.view_account_payment_form"/>
            <field name="arch" type="xml">
                <xpath expr="//field[@name='date']" position="after">
                        <field name="recibo_id" invisible="payment_type != 'inbound'"/>
                </xpath>
            </field>
        </record>

         <record id="view_account_payment_search_inh_recibo" model="ir.ui.view">
            <field name="name">view_account_payment_search_inh_recibo</field>
            <field name="model">account.payment</field>
            <field name="type">search</field>
            <field name="inherit_id" ref="account.view_account_payment_search"/>
            <field name="arch" type="xml">
                <xpath expr="//field[@name='journal_id']" position="after">
                    <field name="recibo_id" />
                </xpath>
            </field>
        </record>

    </data>

</odoo>