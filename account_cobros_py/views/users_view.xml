<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>

   <!--Herencia res.users para asignacion de obras-->
        <record id="view_users_form_recibo_inh" model="ir.ui.view">
            <field name="name">view.users.form.inh</field>
            <field name="model">res.users</field>
            <field name="type">form</field>
            <field name="inherit_id" ref="base.view_users_form"/>
            <field name="arch" type="xml">
                  <notebook position="inside">
                    <page string="Recibos">
                        <group col="3">
                             <group>
                                <field name="talonario_recibo_ids" widget="many2many"  string="Talonario de recibo" domain="[('state','=','en_uso'),('usuario_talonario_ids','=',False)]" />
                            </group>
                        </group>
                    </page>
                </notebook>
            </field>
        </record>
    </data>
</odoo>
