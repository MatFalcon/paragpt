<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <!-- helpdesk.ticket inherited form view for Odoo 17 -->
        <record id="helpdesk_ticket_view_form_bva" model="ir.ui.view">
            <field name="name">helpdesk_ticket_view_form_bva</field>
            <field name="model">helpdesk.ticket</field>
            <field name="inherit_id" ref="helpdesk.helpdesk_ticket_view_form"/>
            <field name="arch" type="xml">
                <xpath expr="//field[@name='tag_ids']" position="after">
                    <field name="is_iso" groups="bvpasa_helpdesk.grp_iso"/>
                </xpath>
                <xpath expr="//notebook" position="inside">
                    <page name="page_iso" string="ISO" groups="bvpasa_helpdesk.grp_iso" invisible="is_iso == False">
                        <group string="Datos principales">
                            <group>
                                <field name="iso_from_user_id" required="1" invisible="is_iso == False"/>
                                <field name="iso_procedencia" required="1" invisible="is_iso == False"/>
                                <field name="iso_clasificacion" required="1" invisible="is_iso == False"/>
                                <field name="iso_team_id" required="1" invisible="is_iso == False"/>
                            </group>
                            <group>
                                <field name="iso_descripcion" required="1" invisible="is_iso == False"/>
                                <field name="iso_evidencia" required="1" invisible="is_iso == False"/>
                                <field name="iso_referencia" required="1" invisible="is_iso == False"/>
                            </group>
                        </group>
                        <group string="Seguimiento">
                            <group>
                                <field name="iso_accion_inmediata"/>
                                <field name="iso_evaluacion_causa"/>
                                <field name="iso_acciones_correctivas"/>
                            </group>
                            <group>
                                <field name="iso_implementacion_accion"/>
                                <field name="iso_evaluacion_efectividad"/>
                                <field name="iso_cierre"/>
                            </group>
                        </group>
                    </page>
                </xpath>
            </field>
        </record>
    </data>
</odoo>
