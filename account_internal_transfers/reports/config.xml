<odoo>
    <data>
        <!-- Reporte de Transferencia en Cuenta -->
        <record id="report_internal_transfer" model="ir.actions.report">
            <field name="name">Transferencia en cuenta</field>
            <field name="model">transferencias.entre.cuentas</field>
            <field name="report_type">qweb-pdf</field>
            <field name="report_name">account_internal_transfers.internal_transfer_report</field>
            <field name="print_report_name">'%s' % (object.name)</field>
            <field name="binding_model_id" ref="model_transferencias_entre_cuentas"/>
        </record>

        <!-- Reporte de Efectivización -->
        <record id="report_internal_transfer_efectivizacion" model="ir.actions.report">
            <field name="name">Efectivización</field>
            <field name="model">transferencias.entre.cuentas</field>
            <field name="report_type">qweb-pdf</field>
            <field name="report_name">account_internal_transfers.internal_transfer_report_efectivizacion</field>
            <field name="print_report_name">'%s' % (object.name)</field>
            <field name="binding_model_id" ref="model_transferencias_entre_cuentas"/>
        </record>
    </data>
</odoo>
