<odoo>
    <template id="internal_transfer_report_efectivizacion">
        <t t-call="web.html_container">
            <t t-foreach="docs" t-as="o">
                <t t-call="web.external_layout">
<!--                    <div class="header">-->
<!--                        <div class="col-6">-->
<!--                            <h3>-->
<!--                                <span t-field="res_company.name"/>-->
<!--                            </h3>-->
<!--                        </div>-->
<!--                        &lt;!&ndash;Fecha y paginacion de hoja&ndash;&gt;-->
<!--                        <div class="col-4 pull-right fecha">-->
<!--                            <p>Fecha:-->
<!--                                <span t-esc="context_timestamp(datetime.datetime.now()).strftime('%d/%m/%Y %H:%M')"/>-->
<!--                            </p>-->
<!--                            <span>Pag:</span>-->
<!--                            <span class="page"/>-->
<!--                            de-->
<!--                            <span class="topage"/>-->
<!--                        </div>-->
<!--                    </div>-->
                    <div class="row">
                        <div class="col-6">
                            <h3>Efectivización
                            </h3>
                            <h5>Nº <span t-field="o.name"/></h5>
                        </div>
                    </div>
                    <br></br>
                    <br></br>
                    <link rel="stylesheet" href="account_internal_transfers/static/src/style_it.css"/>
                    <div class="page">
                        <div class="row ">
                                <div class="col-10" id="referencia">
                                    <p>Fecha:
                                        <span t-field="o.fecha"/>
                                    </p>
                                    <p>Referencia:<span t-field="o.observacion"/></p>
                                </div>
<!--                                <div class="col-6">-->
<!--                                    <p>Referencia:-->
<!--                                        <span t-field="o.observacion"/>-->
<!--                                    </p>-->
<!--                                </div>-->
                        </div>
                        <br></br>
                        <br></br>
                        <t t-set="moneda"/>
                        <t t-set="suma" t-value="0"/>

                        <t t-if="o.move_id">
                            <t t-set="suma" t-value="o.transfer_value()"/>
                            <t t-set="moneda" t-value="o.set_currency()"/>
                        </t>
                        <!--TABLA PARA EL REPORTE DE CHEQUES PROPIOS-->

                        <table class="sin-borde">
                            <thead>
                                <tr class="active">
                                    <th>Cuenta de origen</th>
<!--                                    <th>Moneda de origen</th>-->
                                    <th>Cuenta Destino</th>
<!--                                    <th>Moneda de destino</th>-->
                                    <th>Cantidad a Efectivizar</th>
                                    <th>Cantidad Efectivizada</th>
                                    <th>Tasa de Cambio</th>
<!--                                    <th>Diferencia de cambio</th>-->
                                </tr>
                            </thead>
                            <tbody>

                                    <tr>
                                        <td>
                                            <span t-field="o.cuenta_origen"/>
                                        </td>
<!--                                        <td>-->
<!--                                            <span t-field="o.currency_id"/>-->
<!--                                        </td>-->
                                        <td>
                                            <span t-field="o.cuenta_destino"/>
                                        </td>
<!--                                        <td>-->
<!--                                            <span t-field="o.currency_dest_id"/>-->
<!--                                        </td>-->
                                        <td>
                                            <span t-field="o.monto"/>
                                        </td>
                                        <td>
                                            <t t-if="moneda">
                                                 <span t-esc ="o.agregar_punto_de_miles(suma, moneda)"/> <span t-esc ="moneda.symbol"/>
                                            </t>
                                        </td>
                                        <td>
                                            <span t-field="o.tasa_cambio"/>
                                        </td>
<!--                                        <td>-->
<!--                                            <span t-field="o.diferencia_cambio"/>-->
<!--                                        </td>-->
                                    </tr>
                            </tbody>

                        </table>
                        <br/>
                        <br/>
                        <br/>
                        <br/>
                        <br/>
                        <div class="row">
                            <div class="col-6">
                                <b>
                                    <span>Elaborado por:</span>
                                </b>
                            </div>
                            <br></br>
                            <br></br>
                            <br></br>
                            <br></br>
                            <br></br>
                            <div class="col-6">
                                <b>
                                    <span>Aclaracion:</span>
                                </b>
                            </div>
                        </div>
                        <br/>
                        <div class="row">
                            <div class="col-6">
                                <b>
                                    <span>Autorizado por:</span>
                                </b>
                            </div>
                            <div class="col-6">
                                <b>
                                    <span>Aclaracion:</span>
                                </b>
                            </div>
                        </div>
                    </div>
                </t>
            </t>
        </t>


    </template>
</odoo>