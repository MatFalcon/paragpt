<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <record id="account_internal_transfer_comp_rule" model="ir.rule">
        <field name="name">Transferencias Internas</field>
        <field name="model_id" ref="model_transferencias_entre_cuentas"/>
        <field name="global" eval="True"/>
        <field name="domain_force">['|',('company_id','=',False),('company_id', 'in', company_ids)]</field>
        </record>


         <record id="action_validar_trans" model="ir.actions.server">
                    <field name="name">Validar Transferencias</field>
                    <field name="model_id" ref="model_transferencias_entre_cuentas"/>
                    <field name="binding_model_id" ref="model_transferencias_entre_cuentas"/>
                    <field name="binding_view_types">list,form</field>
                    <field name="state">code</field>
                    <field name="code">
                    for rec in records:

                        rec.confirmar()

                    </field>
                </record>

    </data>
</odoo>