<odoo>
    <record id="pos_order_form_view_inherit" model="ir.ui.view">
        <field name="name">pos.order.form.inherit</field>
        <field name="model">pos.order</field>
        <field name="inherit_id" ref="point_of_sale.view_pos_pos_form" />
        <field name="arch" type="xml">
            <xpath expr="//field[@name='partner_id']" position="after">
                <field name="doctor" />
            </xpath>
            <xpath expr="//tree//field[@name='qty']" position="replace">
                <field name="secondary_qty" />
                <field name="secondary_uom_id"/>
            </xpath>
            <xpath expr="//form//group//field[@name='qty']" position="replace">
                <field name="secondary_qty" />
            </xpath>
        </field>
    </record>
    <record id="account_move_form_view_inherit" model="ir.ui.view">
        <field name="name">account.move.form.inherit</field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="account.view_move_form" />
        <field name="arch" type="xml">
            <xpath expr="//field[@name='quantity']" position="replace">
                <field name="secondary_qty" optional="show"/>
            </xpath>
        </field>
    </record>
</odoo>