<?xml version="1.0" encoding="UTF-8"?>
<templates id="template" xml:space="preserve">
    <t t-name="pos_pharmacy_management.ShowUomOptionsPopup" owl="1">
        <div class="popup wk_popup uom-options-popup">
            <header class="modal-header">
                <t class="modal-title" t-esc="props.title" />
            </header>
            <main class="modal-body uom_popup_body">
                <t t-foreach="props.line.product.product_price_by_uom" t-as="uom_line" t-key="uom_line">
                    <div class="uom_line" t-att-uom-id="uom_line" t-on-click="(ev) => this.onShowUomClick(ev, uom_line)">
                        <t t-set="line" t-value="pos.product_uom_price[uom_line]"/>
                        <span class="uom_line_qty" t-esc="line.qty"/>
                        <div class="uom_line_name" t-esc="line.uom_id[1]" />
                    </div>
                </t>
                <t t-if="props.selected_uom_id and line.uom_id[0] === props.selected_uom_id">
                    <div class="previous_uom_line" t-att-previous-uom-id="props.previous_unit[0]" t-on-click="(ev) => this.onShowpreviousUom(ev,props.previous_unit[0])">
                        <div class="uom_line_name" t-esc="props.previous_unit[1]" />
                    </div>
                </t>
            </main>
            <div style="width: fit-content;display: flex;margin-left: 17px;">
                <div style="text-align: justify;margin-top: 1%;width: fit-content;">Quantity-</div>
                <div style="/* width:171px; */width: fit-content;margin-left: 7px;margin-bottom: 2%;">
                    <input class="button qty_input" id="qtyInput" placeholder="0" type="number" style="margin-right: 134px;text-align: left;width: 108px;"/>
                </div>
            </div>
            <span id="message" style="color: red; display: none; margin-left: -62%;margin-bottom: 1%;">Please Enter Quantity"</span>
            <footer class="footer modal-footer">
                <div class="button cancel btn btn-lg btn-primary" t-on-click="confirm"> Confirm </div>
                <div class="button cancel btn btn-lg btn-primary" t-on-click="cancel"> Cancel </div>
            </footer>
        </div>
    </t>
</templates>