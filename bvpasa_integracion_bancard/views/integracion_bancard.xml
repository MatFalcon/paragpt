<odoo>
    <!-- Acción para la vista tree -->
    <record model="ir.actions.act_window" id="integracion_bancard_tree_action">
        <field name="name">Integración Bancard</field>
        <field name="res_model">bvpasa_integracion_bancard</field>
        <field name="view_mode">tree,form</field>
        <field name="view_id" ref="integracion_bancard_tree_view"/>
    </record>

    <!-- Vista tree -->
    <record model="ir.ui.view" id="integracion_bancard_tree_view">
        <field name="name">integracion_bancard_tree_view</field>
        <field name="model">bvpasa_integracion_bancard</field>
        <field name="arch" type="xml">
            <tree string="Integración Bancard" create="0">
                <field name="nro_transaccion"/>
                <field name="tipo_tarjeta"/>
                <field name="currency_id"/>
                <field name="importe"/>
                <field name="tipo"/>
                <field name="estado"/>
                <field name="monto_comision"/>
                <field name="iva_s_comision"/>
                <field name="retencion_renta"/>
                <field name="retencion_iva"/>
                <field name="importe_neto"/>
                <field name="fecha_venta"/>
                <field name="fecha_credito_comercio"/>
                <field name="campus_id"/>
                <field name="invoice_id"/>
            </tree>
        </field>
    </record>

    <!-- Vista form -->
    <record model="ir.ui.view" id="integracion_bancard_form_view">
        <field name="name">integracion_bancard_form_view</field>
        <field name="model">bvpasa_integracion_bancard</field>
        <field name="arch" type="xml">
            <form string="Integración Bancard">
                <sheet>
                    <group>
                        <group>
                            <field name="nro_transaccion"/>
                            <field name="tipo_tarjeta"/>
                            <field name="currency_id"/>
                            <field name="importe"/>
                            <field name="tipo"/>
                            <field name="estado"/>
                        </group>
                        <group>
                            <field name="monto_comision"/>
                            <field name="iva_s_comision"/>
                            <field name="retencion_renta"/>
                            <field name="retencion_iva"/>
                            <field name="importe_neto"/>
                        </group>
                    </group>
                    <group>
                        <group>
                            <field name="fecha_venta"/>
                            <field name="fecha_credito_comercio"/>
                        </group>
                        <group>
                            <field name="campus_id"/>
                            <field name="invoice_id"/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <!-- Acción para la vista form -->
    <record model="ir.actions.act_window" id="integracion_bancard_form_action">
        <field name="name">Integración Bancard Form</field>
        <field name="res_model">bvpasa_integracion_bancard</field>
        <field name="view_mode">form</field>
        <field name="view_id" ref="integracion_bancard_form_view"/>
        <field name="target">current</field>
    </record>

    <!-- Menú para acceder a la acción tree -->
    <menuitem id="bvpasa_integracion_bancard.menu_root" name="Integración Bancard" parent="account.menu_finance_receivables"
              action="integracion_bancard_tree_action"/>
</odoo>

