<odoo>
    <data>
        <record model="ir.ui.view" id="inherit_orden_pago_form_view">
            <field name="name">orden_pago.form.inherit</field>
            <field name="model">account.orden.pago</field>
            <field name="inherit_id" ref="account_payment_py.orden_pago_form_view"/>
            <field name="arch" type="xml">
                <header position="inside">
                    <button name="set_pendiente" string="Marcar como Pendiente" type="object"
                            class="oe_highlight" invisible="state != 'borrador'"
                            groups="bva_custom.grupo_orden_pago_pendiente"/>
                </header>

                <xpath expr="//button[@name='set_borrador']" position="attributes">
                    <attribute name="invisible">state in ('borrador', 'pendiente')</attribute>
                </xpath>

                <xpath expr="//button[@name='confirmar_orden_pago']" position="attributes">
                    <attribute name="invisible">state != 'pendiente'</attribute>
                    <attribute name="groups">bva_custom.grupo_orden_pago_confirmar</attribute>
                </xpath>
            </field>
        </record>
    </data>
</odoo>