<odoo>
    <data noupdate="1">
        <record forcecreate="True" id="enviar_recordatorio_cuentas_cobrar_dia" model="ir.cron">
            <field name="name">Enviar recordatorio de cuentas a cobrar</field>
            <field eval="False" name="active"/>
            <field name="user_id" ref="base.user_root"/>
            <field name="interval_number">7</field>
            <field name="interval_type">days</field>
            <field name="numbercall">-1</field>
            <field ref="base.model_res_partner" name="model_id"/>
            <field name="state">code</field>
            <field name="code">model.enviarCuentasCobrar()</field>
            <field eval="False" name="doall"/>
        </record>
    </data>


    <data noupdate="1">
        <record id="mail_template_cuentas_cobrar" model="mail.template">
            <field name="name">Recordatorio de pago: Enviar por Email</field>
            <field name="model_id" ref="base.model_res_partner"/>
            <field name="subject">{{object.company_id.name}} Recordatorio de pago - {{ object.name }})</field>
            <field name="email_from">{{(object.user_id.email_formatted)}}</field>
            <field name="body_html" type="html">
                <div style="margin: 0px; padding: 0px;">
                    Estimado/a <t t-out="object.name or ''" contenteditable="false" data-oe-t-inline="true"/>,<br/>
                    Adjunto encontrará los importes pendientes de pago.
                    <br/>
                    <br/>
                    <h3 style="margin:0px 0 12px 0;box-sizing:border-box;">Detalle de las facturas</h3>
                    <t t-out="object.facturas_pendientes_texto" contenteditable="false" data-oe-t-inline="true">
                    </t>
                    <br/>
                    Por favor, tome las medidas pertinentes en la brevedad posible.
                    <br/>
                    Las cuentas habilitadas para el efecto son:<br/>
                    <table>
                        <tr>
                            <td>
                                Moneda
                            </td>
                            <td>
                                Tipo
                            </td>
                            <td>
                                Entidad
                            </td>
                            <td>
                                Número
                            </td>
                        </tr>
                        <tr>
                            <td>
                                Guaraníes
                            </td>
                            <td>
                                Cuenta Corriente
                            </td>
                            <td>
                                Banco Itaú
                            </td>
                            <td>
                                423308
                            </td>
                        </tr>
                        <tr>
                            <td>
                                Dólares
                            </td>
                            <td>
                                Caja de Ahorro
                            </td>
                            <td>
                                Banco Itaú
                            </td>
                            <td>
                                15381677
                            </td>
                        </tr>
                    </table>

                    <br/><br/>
                    No dude en contactarnos en caso de alguna duda.<br/><br/>
                    Atentamente,<br/>
                    Bolsa de Valores y Productos de Asunción S.A.<br/>
                    Bulnes 830 c/ España<br/>
                    Asunción – Paraguay<br/>
                    +595 21 728-9123/5<br/>
                    www.bolsadevalores.com.py<br/><br/><br/>
                    Saludos.
                </div>

            </field>
            <field name="lang">${object.lang}</field>
            <field name="auto_delete" eval="False"/>
        </record>
    </data>
    <data noupdate="1">

            <record id="enviar_recordatorio_emisores" model="ir.cron">
                <field name="name">Recordatorio Emisores</field>
                <field name="active" eval="False"/>
                <field name="user_id" ref="base.user_root"/>
                <field name="interval_number">7</field>
                <field name="interval_type">days</field>
                <field name="numbercall">-1</field>
                <field name="model_id" ref="base.model_res_partner"/>
                <field name="state">code</field>
                <field name="code">model.enviarRecordatorioEmisores()</field>
                <field name="doall" eval="False"/>
            </record>
    </data>

    <data noupdate="1">
        <record id="mail_template_recordatorio_emisores" model="mail.template">
            <field name="name">Recordatorio Emisores: Enviar Mail</field>
            <field name="model_id" ref="base.model_res_partner"/>
            <field name="subject">Capital Integrado</field>
            <field name="email_from">{{(object.user_id.email_formatted)}}</field>
            <field name="body_html" type="html">
                <div style="margin: 0px; padding: 0px;">
                    <![CDATA[
                <p>Buenos días estimados.</p>
                <p>Favor si podrían compartirnos una nota detallando su capital integrado correspondiente al cierre 2024 según resolución 1679/17 para el cobro de mantenimiento de registro del 2025.</p>
                <p>En caso de haber enviado la nota omitir la solicitud.</p>
                <br/><br/>
                Bolsa de Valores y Productos de Asunción S.A.<br/>
                Bulnes 830 c/ España<br/>
                Asunción – Paraguay<br/>
                +595 21 728-9123/5<br/>
                www.bolsadevalores.com.py<br/><br/>
                Saludos.
                ]]>
                </div>

            </field>
            <field name="lang">${object.lang}</field>
            <field name="auto_delete" eval="False"/>
        </record>
    </data>



</odoo>