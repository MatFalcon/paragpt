<odoo>
    <template id="factura_report_web">
        <t t-call="web.html_container">
            <t t-foreach="docs" t-as="o">
                <t t-set="doc" t-value="o"/>
                <t t-set="company" t-value="doc.company_id"/>
                <t t-call="web.basic_layout">
                     <link rel="stylesheet" href="/factura_electronica/static/src/css/kude.css"/>
                    <div class="page">

                        <div id="contenedor">
                            <t t-call="portal_customer.header_factura_report"/>
                            <t t-call="portal_customer.factura_cliente_datos_report"/>
                            <t t-call="portal_customer.factura_items_report"/>
                            <t t-call="portal_customer.footer_factura_report"/>
                        </div>
                    </div>

                    <style>
                        .page{
                        height: 25cm;
                        }
                        #contenedor{
                        height: 10cm;

                        }
                    </style>
                </t>
            </t>
        </t>
    </template>
</odoo>
